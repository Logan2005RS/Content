[ai_queue3,dagcave_ranged_boss]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);
obj_add(npc_coord, dagganoth_hide, 1, ^lootdrop_duration);
def_int $random = random(128);
if ($random < 10) {
    obj_add(npc_coord, mithril_knife, add(random(26), 25), ^lootdrop_duration);
} else if ($random < 17) {
    obj_add(npc_coord, red_dragon_vambraces, 1, ^lootdrop_duration);
} else if ($random < 22) {
    obj_add(npc_coord, rune_thrownaxe, add(random(6), 5), ^lootdrop_duration);
} else if ($random < 27) {
    obj_add(npc_coord, adamant_dart, add(random(16), 10), ^lootdrop_duration);
} else if ($random < 32) {
    obj_add(npc_coord, iron_knife, add(random(301), 200), ^lootdrop_duration);
} else if ($random < 37) {
    obj_add(npc_coord, steel_knife, add(random(101), 50), ^lootdrop_duration);
} else if ($random < 38) {
    obj_add(npc_coord, viking_sword, 1, ^lootdrop_duration);
} else if ($random < 39) {
    obj_add(npc_coord, viking_helmet, 1, ^lootdrop_duration);
} else if ($random < 40) {
    obj_add(npc_coord, viking_shield, 1, ^lootdrop_duration);
} else if ($random < 41) {
    obj_add(npc_coord, daganoth_cave_magic_shortbow, 1, ^lootdrop_duration);
} else if ($random < 42) {
    obj_add(npc_coord, dragon_axe, 1, ^lootdrop_duration);
} else if ($random < 43) {
    obj_add(npc_coord, viking_helmet_range, 1, ^lootdrop_duration);
} else if ($random < 44) {
    obj_add(npc_coord, dagganoth_ranged_body, 1, ^lootdrop_duration);
} else if ($random < 45) {
    obj_add(npc_coord, dagganoth_ranged_legs, 1, ^lootdrop_duration);
} else if ($random < 46) {
    obj_add(npc_coord, ranger_ring, 1, ^lootdrop_duration);
} else if ($random < 51) {
} else if ($random < 56) {
    obj_add(npc_coord, steel_arrow, add(random(201), 50), ^lootdrop_duration);
} else if ($random < 60) {
    obj_add(npc_coord, iron_arrow, add(random(301), 200), ^lootdrop_duration);
} else if ($random < 67) {
    obj_add(npc_coord, ~randomrareseed, ^lootdrop_duration);
} else if ($random < 77) {
    obj_add(npc_coord, coins, 156, ^lootdrop_duration);
} else if ($random < 83) {
    obj_add(npc_coord, bigoysterpearls, 1, ^lootdrop_duration);
} else if ($random < 88) {
    obj_add(npc_coord, opal_bolttips, add(random(21), 10), ^lootdrop_duration);
} else if ($random < 93) {
    obj_add(npc_coord, shark, 5, ^lootdrop_duration);
} else if ($random < 98) {
    obj_add(npc_coord, unidentified_ranarr, 1, ^lootdrop_duration);
} else if ($random < 103) {
    obj_add(npc_coord, cert_maple_logs, add(random(101), 50), ^lootdrop_duration);
} else if ($random < 106) {
    obj_add(npc_coord, cert_yew_logs, add(random(101), 50), ^lootdrop_duration);
} else if ($random < 108) {
} else if ($random < 109) {
    obj_add(npc_coord, feather, add(random(251), 250), ^lootdrop_duration);
} else if ($random < 110) {
    ~trail_hardcluedrop(1, npc_coord);
} else if ($random < 120) {
    obj_add(npc_coord, ~randomjewel, ^lootdrop_duration);
} else if ($random < 128) {
    obj_add(npc_coord, ~ultrarare_getitem, ^lootdrop_duration);
}

