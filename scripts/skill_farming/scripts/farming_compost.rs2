[proc,farming_bin_get](int $bin)(int)
switch_int ($bin) {
    case 0 : return(%farming_compost_bin_varbit_1);
    case 1 : return(%farming_compost_bin_varbit_2);
    case 2 : return(%farming_compost_bin_varbit_3);
    case 3 : return(%farming_compost_bin_varbit_4);
}
return(0);

[proc,farming_bin_set](int $bin, int $value)
switch_int ($bin) {
    case 0 : %farming_compost_bin_varbit_1 = $value;
    case 1 : %farming_compost_bin_varbit_2 = $value;
    case 2 : %farming_compost_bin_varbit_3 = $value;
    case 3 : %farming_compost_bin_varbit_4 = $value;
}

[proc,farming_bin_done](int $bin)(boolean)
if (testbit(%farming_growth_data, add(^farming_bin_done_bit, $bin)) = ^true) {
    return(true);
}
return(false);

[proc,farming_bin_set_done](int $bin, boolean $done)
if ($done = true) {
    %farming_growth_data = setbit(%farming_growth_data, add(^farming_bin_done_bit, $bin));
} else {
    %farming_growth_data = clearbit(%farming_growth_data, add(^farming_bin_done_bit, $bin));
}

[proc,farming_bin_closed](int $value)(boolean)
if ($value = ^farming_bin_closed_compost | $value = ^farming_bin_closed_supercompost | $value = ^farming_bin_closed_tomatoes) {
    return(true);
}
return(false);

[proc,farming_compost_bins_update](int $last, int $now)
if (~farming_steps(^farming_bin_rot_period, $last, $now, 1) < 1) {
    return;
}
def_int $bin = 0;
while ($bin < 4) {
    if (~farming_bin_closed(~farming_bin_get($bin)) = true) {
        ~farming_bin_set_done($bin, true);
    }
    $bin = add($bin, 1);
}

[oploc1,farming_compost_bin_1] @farming_bin_op(0);
[oploc1,farming_compost_bin_2] @farming_bin_op(1);
[oploc1,farming_compost_bin_3] @farming_bin_op(2);
[oploc1,farming_compost_bin_4] @farming_bin_op(3);

[label,farming_bin_op](int $bin)
if (~farming_members_check = false) {
    return;
}
def_int $value = ~farming_bin_get($bin);
if ($value = 15 | $value = 47 | $value = 143) {
    if ($value = 15) {
        ~farming_bin_set($bin, ^farming_bin_closed_compost);
    } else if ($value = 47) {
        ~farming_bin_set($bin, ^farming_bin_closed_supercompost);
    } else {
        ~farming_bin_set($bin, ^farming_bin_closed_tomatoes);
    }
    ~farming_bin_set_done($bin, false);
    sound_synth(compost_close, 1, 0);
    mes("You close the compost bin.");
    mes("The contents have begun to rot.");
    return;
}
if (~farming_bin_closed($value) = true) {
    if (~farming_bin_done($bin) = false) {
        mes("I should probably wait until it is done to open it.");
        return;
    }
    ~farming_bin_set_done($bin, false);
    if ($value = ^farming_bin_closed_compost) {
        ~farming_bin_set($bin, 30);
    } else if ($value = ^farming_bin_closed_supercompost) {
        ~farming_bin_set($bin, 62);
    } else {
        ~farming_bin_set($bin, 158);
    }
    sound_synth(compost_open, 1, 0);
    mes("You open the compost bin.");
    return;
}
if ($value >= 144 & $value <= 158) {
    if (inv_freespace(inv) < 1) {
        mes("You don't have enough inventory space to do this.");
        return;
    }
    anim(human_pickuptable, 0);
    sound_synth(farming_scoop, 1, 0);
    inv_add(inv, rotten_tomato, 1);
    stat_advance(farming, 45);
    if ($value = 144) {
        ~farming_bin_set($bin, 0);
    } else {
        ~farming_bin_set($bin, sub($value, 1));
    }
}

[oplocu,farming_compost_bin_1] @farming_bin_use(0);
[oplocu,farming_compost_bin_2] @farming_bin_use(1);
[oplocu,farming_compost_bin_3] @farming_bin_use(2);
[oplocu,farming_compost_bin_4] @farming_bin_use(3);

[label,farming_bin_use](int $bin)
if (~farming_members_check = false) {
    return;
}
def_int $value = ~farming_bin_get($bin);
switch_obj (last_useitem) {
    case bucket_empty :
        if (($value < 16 | $value > 30) & ($value < 48 | $value > 62)) {
            ~mesbox("You can only scoop an opened bin of finished compost.");
            return;
        }
        while (inv_total(inv, bucket_empty) > 0 & $value ! 0) {
            anim(human_pickuptable, 0);
            sound_synth(farming_scoop, 1, 0);
            inv_del(inv, bucket_empty, 1);
            if ($value >= 48) {
                inv_add(inv, bucket_supercompost, 1);
                stat_advance(farming, 85);
                if ($value = 48) {
                    $value = 0;
                } else {
                    $value = sub($value, 1);
                }
            } else {
                inv_add(inv, bucket_compost, 1);
                stat_advance(farming, 45);
                if ($value = 16) {
                    $value = 0;
                } else {
                    $value = sub($value, 1);
                }
            }
            ~farming_bin_set($bin, $value);
            p_delay(1);
        }
        return;
    case supercompost_potion_4, supercompost_potion_3, supercompost_potion_2, supercompost_potion_1 :
        if ($value < 16 | $value > 30) {
            ~mesbox("You can only do this with an open bin of finished regular compost.");
            return;
        }
        def_obj $potion = last_useitem;
        anim(rd_pour_vial, 0);
        p_delay(1);
        inv_del(inv, $potion, 1);
        inv_add(inv, ~farming_compost_potion_next($potion), 1);
        ~farming_bin_set($bin, add($value, 32));
        return;
}
db_find(farming_compostable:item, last_useitem);
def_dbrow $row = db_findnext;
if ($row = null) {
    ~displaymessage(^dm_default);
    return;
}
if (~farming_bin_closed($value) = true | ($value >= 16 & $value <= 30) | ($value >= 48 & $value <= 62) | $value >= 144) {
    ~mesbox("The compost bin must be empty of compost before you can put new items in it.");
    return;
}
if ($value = 15 | $value = 47 | $value = 143) {
    mes("This compost bin is already full.");
    return;
}
def_obj $item = last_useitem;
def_boolean $super = db_getfield($row, farming_compostable:super, 0);
while (inv_total(inv, $item) > 0 & $value ! 15 & $value ! 47 & $value ! 143) {
    anim(human_pickuptable, 0);
    sound_synth(farming_putin, 1, 0);
    inv_del(inv, $item, 1);
    if ($value = 0) {
        if ($item = tomato) {
            $value = 129;
        } else if ($super = true) {
            $value = 33;
        } else {
            $value = 1;
        }
    } else if ($value >= 129) {
        if ($item = tomato) {
            $value = add($value, 1);
        } else {
            $value = sub($value, 127);
        }
    } else if ($value >= 33) {
        if ($super = true) {
            $value = add($value, 1);
        } else {
            $value = sub($value, 31);
        }
    } else {
        $value = add($value, 1);
    }
    ~farming_bin_set($bin, $value);
    p_delay(1);
}

[proc,farming_compost_potion_next](obj $potion)(namedobj)
switch_obj ($potion) {
    case supercompost_potion_4 : return(supercompost_potion_3);
    case supercompost_potion_3 : return(supercompost_potion_2);
    case supercompost_potion_2 : return(supercompost_potion_1);
}
return(vial_empty);
