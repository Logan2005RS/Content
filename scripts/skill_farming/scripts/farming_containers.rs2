[proc,farming_container_type](obj $produce)(int)
switch_obj ($produce) {
    case potato : return(0);
    case onion : return(1);
    case cabbage : return(2);
    case cooking_apple : return(3);
    case banana : return(4);
    case orange : return(5);
    case strawberry : return(6);
    case tomato : return(7);
}
return(-1);

[proc,farming_container_for](int $type, int $count)(dbrow)
db_find(farming_container:key, calc($type * 16 + $count));
return(db_findnext);

[proc,farming_container_produce](obj $container)(namedobj)
if ($container = sack_empty) {
    if (inv_total(inv, potato) > 0) return(potato);
    if (inv_total(inv, onion) > 0) return(onion);
    if (inv_total(inv, cabbage) > 0) return(cabbage);
    return(null);
}
if ($container = basket_empty) {
    if (inv_total(inv, orange) > 0) return(orange);
    if (inv_total(inv, cooking_apple) > 0) return(cooking_apple);
    if (inv_total(inv, banana) > 0) return(banana);
    if (inv_total(inv, strawberry) > 0) return(strawberry);
    if (inv_total(inv, tomato) > 0) return(tomato);
    return(null);
}
db_find(farming_container:item, $container);
def_dbrow $row = db_findnext;
if ($row = null) {
    return(null);
}
return(db_getfield($row, farming_container:produce, 0));

[label,farming_container_fill](obj $container)
def_namedobj $produce = ~farming_container_produce($container);
if ($produce = null | inv_total(inv, $produce) = 0) {
    ~displaymessage(^dm_default);
    return;
}
def_int $type = ~farming_container_type($produce);
def_int $count = 0;
def_int $capacity = 10;
db_find(farming_container:item, $container);
def_dbrow $row = db_findnext;
if ($row ! null) {
    $count = db_getfield($row, farming_container:count, 0);
    $capacity = db_getfield($row, farming_container:capacity, 0);
} else if ($container = basket_empty) {
    $capacity = 5;
}
if ($count >= $capacity) {
    mes("This is already full.");
    return;
}
def_int $amount = min(inv_total(inv, $produce), sub($capacity, $count));
inv_del(inv, $produce, $amount);
inv_del(inv, $container, 1);
inv_add(inv, db_getfield(~farming_container_for($type, add($count, $amount)), farming_container:result, 0), 1);

[label,farming_container_remove_one](obj $container, int $slot)
db_find(farming_container:item, $container);
def_dbrow $row = db_findnext;
if ($row = null) {
    return;
}
if (inv_freespace(inv) < 1) {
    mes("You don't have enough inventory space to do this.");
    return;
}
def_namedobj $produce = db_getfield($row, farming_container:produce, 0);
def_int $count = db_getfield($row, farming_container:count, 0);
if ($count <= 1) {
    inv_setslot(inv, $slot, db_getfield($row, farming_container:empty, 0), 1);
} else {
    inv_setslot(inv, $slot, db_getfield(~farming_container_for(~farming_container_type($produce), sub($count, 1)), farming_container:result, 0), 1);
}
inv_add(inv, $produce, 1);
