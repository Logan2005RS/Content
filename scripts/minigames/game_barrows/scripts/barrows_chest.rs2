[oploc1,barrows_stone_chest]
if (p_finduid(uid) = false) return;
if (%barrows_chest_open = 0) {
    def_npc $npc = ~barrows_brother_npc(~barrows_tunnel);
    if (~barrows_killed(~barrows_tunnel) = false & ~barrows_hunt_brother($npc) = false) {
        ~barrows_spawn_brother($npc, ^barrows_speech_steal_chest);
    }
    %barrows_chest_open = 1;
    return;
}
if (~barrows_collapsing = true) {
    mes("The chest is empty.");
    return;
}
cam_shake(0, 5, 0, 0);
%barrows = setbit(%barrows, ^barrows_collapsing_bit);
settimer(barrows_collapse, 3);
~music_jingle(midi_382);
~barrows_loot;

[oploc2,barrows_stone_chest]
%barrows_chest_open = 0;

[proc,barrows_loot]
inv_clear(trail_rewardinv);
def_int $killed = ~barrows_killed_total;
def_int $table_rolls = add(1, $killed);
def_int $reward_potential = add(%barrows_killed_monster, multiply($killed, 2));
def_int $unique_chance = sub(450, multiply(58, $killed));
def_int $given = 0;
while ($table_rolls > 0) {
    if (random($unique_chance) = 0 & ~barrows_loot_unique_count($given) > 0) {
        $given = ~barrows_loot_give_unique($given);
    } else {
        ~barrows_loot_default($reward_potential);
    }
    $table_rolls = sub($table_rolls, 1);
}
inv_transmit(trail_rewardinv, trail_reward:inv);
if_openmain(trail_reward);
queue(barrows_give_reward, 0, 0);

[queue,barrows_give_reward]
def_int $slot = 0;
while ($slot < inv_size(trail_rewardinv)) {
    if (inv_getnum(trail_rewardinv, $slot) > 0) {
        inv_movefromslot(trail_rewardinv, inv, $slot);
    }
    $slot = add($slot, 1);
}
inv_clear(trail_rewardinv);

[proc,barrows_loot_unique_available](int $piece, int $given)(boolean)
if (testbit($given, $piece) = ^true) {
    return(false);
}
return(~barrows_killed(add(divide($piece, 4), ^barrows_ahrim)));

[proc,barrows_loot_unique_count](int $given)(int)
def_int $count = 0;
def_int $piece = 0;
while ($piece < 24) {
    if (~barrows_loot_unique_available($piece, $given) = true) {
        $count = add($count, 1);
    }
    $piece = add($piece, 1);
}
return($count);

[proc,barrows_loot_give_unique](int $given)(int)
def_int $pick = random(~barrows_loot_unique_count($given));
def_int $piece = 0;
while ($piece < 24) {
    if (~barrows_loot_unique_available($piece, $given) = true) {
        if ($pick = 0) {
            inv_add(trail_rewardinv, ~barrows_loot_piece($piece), 1);
            return(setbit($given, $piece));
        }
        $pick = sub($pick, 1);
    }
    $piece = add($piece, 1);
}
return($given);

[proc,barrows_loot_piece](int $piece)(namedobj)
switch_int ($piece) {
    case 0 : return(barrows_ahrim_head);
    case 1 : return(barrows_ahrim_weapon);
    case 2 : return(barrows_ahrim_body);
    case 3 : return(barrows_ahrim_legs);
    case 4 : return(barrows_dharok_head);
    case 5 : return(barrows_dharok_weapon);
    case 6 : return(barrows_dharok_body);
    case 7 : return(barrows_dharok_legs);
    case 8 : return(barrows_guthan_head);
    case 9 : return(barrows_guthan_weapon);
    case 10 : return(barrows_guthan_body);
    case 11 : return(barrows_guthan_legs);
    case 12 : return(barrows_karil_head);
    case 13 : return(barrows_karil_weapon);
    case 14 : return(barrows_karil_body);
    case 15 : return(barrows_karil_legs);
    case 16 : return(barrows_torag_head);
    case 17 : return(barrows_torag_weapon);
    case 18 : return(barrows_torag_body);
    case 19 : return(barrows_torag_legs);
    case 20 : return(barrows_verac_head);
    case 21 : return(barrows_verac_weapon);
    case 22 : return(barrows_verac_body);
}
return(barrows_verac_legs);

[proc,barrows_loot_default](int $reward_potential)
def_int $rand = randominc($reward_potential);
if ($rand = 1012) {
    inv_add(trail_rewardinv, dragon_med_helm, 1);
} else if ($rand > 1005) {
    if (random(2) = 0) {
        inv_add(trail_rewardinv, keyhalf1, 1);
    } else {
        inv_add(trail_rewardinv, keyhalf2, 1);
    }
} else if ($rand > 880) {
    ~barrows_loot_scaled(barrows_karil_ammo, 40, 881, 1005, $reward_potential);
} else if ($rand > 755) {
    ~barrows_loot_scaled(bloodrune, 43, 756, 880, $reward_potential);
} else if ($rand > 630) {
    ~barrows_loot_scaled(deathrune, 83, 631, 755, $reward_potential);
} else if ($rand > 505) {
    ~barrows_loot_scaled(chaosrune, 139, 506, 630, $reward_potential);
} else if ($rand > 380) {
    ~barrows_loot_scaled(mindrune, 336, 381, 505, $reward_potential);
} else if ($rand > 0) {
    ~barrows_loot_scaled(coins, 774, 1, 380, $reward_potential);
}

[proc,barrows_loot_scaled](namedobj $obj, int $max_qty, int $min, int $max, int $reward_potential)
def_int $min_qty = scale($max_qty, $max, $min);
def_int $scaled_max_qty = scale($max_qty, $max, min($max, $reward_potential));
inv_add(trail_rewardinv, $obj, add($min_qty, randominc(sub($scaled_max_qty, $min_qty))));
