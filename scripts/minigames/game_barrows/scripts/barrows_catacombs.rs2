[proc,barrows_catacombs_randomize]
%barrows = clearbit_range(%barrows, 6, 9);
%barrows = clearbit_range(%barrows, 10, 25);
%barrows_door_e = 1;
%barrows_door_i = 1;
%barrows_door_j = 1;
%barrows_door_l = 1;
switch_int (random(4)) {
    case 0 : %barrows_door_e = 0;
    case 1 : %barrows_door_i = 0;
    case 2 : %barrows_door_j = 0;
    case default : %barrows_door_l = 0;
}
def_int $rand = random(4);
if ($rand = 0) {
    %barrows_chamber_a = 1;
    %barrows_door_a = 1;
    %barrows_door_b = 1;
    %barrows_door_c = 1;
    %barrows_door_d = 1;
    switch_int (random(4)) {
        case 0 : %barrows_door_a = 0;
        case 1 : %barrows_door_b = 0;
        case 2 : %barrows_door_c = 0;
        case default : %barrows_door_d = 0;
    }
} else if ($rand = 1) {
    %barrows_chamber_c = 1;
    %barrows_door_a = 1;
    %barrows_door_f = 1;
    %barrows_door_g = 1;
    %barrows_door_h = 1;
    switch_int (random(4)) {
        case 0 : %barrows_door_a = 0;
        case 1 : %barrows_door_f = 0;
        case 2 : %barrows_door_g = 0;
        case default : %barrows_door_h = 0;
    }
} else if ($rand = 2) {
    %barrows_chamber_g = 1;
    %barrows_door_b = 1;
    %barrows_door_k = 1;
    %barrows_door_n = 1;
    %barrows_door_p = 1;
    switch_int (random(4)) {
        case 0 : %barrows_door_b = 0;
        case 1 : %barrows_door_k = 0;
        case 2 : %barrows_door_n = 0;
        case default : %barrows_door_p = 0;
    }
} else {
    %barrows_chamber_i = 1;
    %barrows_door_h = 1;
    %barrows_door_m = 1;
    %barrows_door_o = 1;
    %barrows_door_p = 1;
    switch_int (random(4)) {
        case 0 : %barrows_door_h = 0;
        case 1 : %barrows_door_m = 0;
        case 2 : %barrows_door_o = 0;
        case default : %barrows_door_p = 0;
    }
}

[label,barrows_catacombs_enter]
~mesbox("You've found a hidden tunnel, do you want to enter?");
if (~p_choice2("Yeah I'm fearless!", 1, "No way, that looks scary!", 2) = 1) {
    if (p_finduid(uid) = false) return;
    if (%barrows_chamber_a = 1) {
        p_telejump(map_findsquare(0_55_151_17_47, 0, 2, ^map_findsquare_lineofwalk));
    } else if (%barrows_chamber_c = 1) {
        p_telejump(map_findsquare(0_55_151_48_47, 0, 2, ^map_findsquare_lineofwalk));
    } else if (%barrows_chamber_g = 1) {
        p_telejump(map_findsquare(0_55_151_14_13, 0, 2, ^map_findsquare_lineofwalk));
    } else if (%barrows_chamber_i = 1) {
        p_telejump(map_findsquare(0_55_151_48_13, 0, 2, ^map_findsquare_lineofwalk));
    }
}

[oploc1,_barrows_ladder]
if (p_finduid(uid) = false) return;
p_telejump(~barrows_crypt_ladder_exit(~barrows_tunnel));

[oploc1,_barrows_door]
if (loc_param(barrows_puzzle_door) = true & %barrows_puzzle ! ^barrows_puzzle_completed) {
    @barrows_open_puzzle;
}
@barrows_catacombs_open_door(loc_param(barrows_door_side), loc_param(barrows_door_other));

[label,barrows_catacombs_open_door](int $side, loc $other)
if (p_finduid(uid) = false) return;
def_int $door_angle = loc_angle;
def_locshape $door_shape = loc_shape;
def_coord $original_coord = loc_coord;
def_coord $other_coord = ~barrows_other_door_coord($side, $door_angle, $original_coord);
if (.loc_find($other_coord, $other) = false) {
    return;
}
def_coord $left_coord = $original_coord;
def_coord $right_coord = $other_coord;
if ($side = ^right) {
    $left_coord = $other_coord;
    $right_coord = $original_coord;
}
def_coord $left_door_open_coord = ~barrows_door_movecoord($left_coord, $door_angle, $door_shape);
def_coord $right_door_open_coord = ~barrows_door_movecoord($right_coord, $door_angle, $door_shape);
loc_del(3);
loc_add($original_coord, inviswall, $door_angle, $door_shape, 3);
.loc_del(3);
loc_add($other_coord, inviswall, $door_angle, $door_shape, 3);
~door_open_leaf_opposite($left_coord, $door_angle, $door_shape, barrows_door_inactive_l, 3);
~door_open_leaf($right_coord, $door_angle, $door_shape, barrows_door_inactive_r, 3);
sound_synth(barrows_door_open, 0, 0);
if (coord = $left_door_open_coord | coord = $right_door_open_coord) {
    p_teleport($left_coord);
} else {
    p_teleport($left_door_open_coord);
}
~barrows_door_spawn_monster;

[proc,barrows_door_movecoord](coord $coord, int $angle, locshape $shape)(coord)
def_int $x;
def_int $z;
$x, $z = ~door_open($angle, $shape);
return(movecoord($coord, $x, 0, $z));

[proc,barrows_other_door_coord](int $side, int $angle, coord $base_coord)(coord)
switch_int ($angle) {
    case ^loc_west :
        if ($side = ^left) return(movecoord($base_coord, 0, 0, 1));
        return(movecoord($base_coord, 0, 0, -1));
    case ^loc_north :
        if ($side = ^left) return(movecoord($base_coord, 1, 0, 0));
        return(movecoord($base_coord, -1, 0, 0));
    case ^loc_east :
        if ($side = ^left) return(movecoord($base_coord, 0, 0, -1));
        return(movecoord($base_coord, 0, 0, 1));
}
if ($side = ^left) return(movecoord($base_coord, -1, 0, 0));
return(movecoord($base_coord, 1, 0, 0));

[proc,barrows_door_spawn_monster]
def_int $count = 0;
npc_huntall(coord, 5, 0);
while (npc_findnext = true & $count < 12) {
    $count = add($count, 1);
}
if ($count >= 12) return;
def_int $rand = random(128);
if ($rand < 12) {
    def_int $alive = sub(6, ~barrows_killed_total);
    if ($alive = 0) {
        ~barrows_spawn_npc(barrows_rat, ^barrows_npc_lifetime, opplayer2);
        return;
    }
    def_int $pick = random($alive);
    def_int $brother = ^barrows_ahrim;
    while ($brother <= ^barrows_verac) {
        if (~barrows_killed($brother) = false) {
            if ($pick = 0) {
                def_npc $npc = ~barrows_brother_npc($brother);
                if (~barrows_hunt_brother($npc) = false) {
                    ~barrows_spawn_brother($npc, null);
                }
                return;
            }
            $pick = sub($pick, 1);
        }
        $brother = add($brother, 1);
    }
} else if ($rand < 32) {
    ~barrows_spawn_npc(barrows_skeleton_armed, ^barrows_npc_lifetime, opplayer2);
} else if ($rand < 64) {
    ~barrows_spawn_npc(barrows_skeleton_unarmed, ^barrows_npc_lifetime, opplayer2);
} else if ($rand < 96) {
    ~barrows_spawn_npc(barrows_bloodworm, ^barrows_npc_lifetime, opplayer2);
} else {
    ~barrows_spawn_npc(barrows_rat, ^barrows_npc_lifetime, opplayer2);
}
