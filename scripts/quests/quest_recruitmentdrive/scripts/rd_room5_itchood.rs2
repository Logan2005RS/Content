[label,rd_itchood_intro]
if (npc_find(coord, rd_observer_room_5, 15, 0) = false) {
    return;
}
@rd_itchood_talk;

[opnpc1,rd_observer_room_5]
if (%rd_room5_complete = ^true) {
    ~chatnpc("<p,happy>Your wit is sharp, your brains quite clear;|You solved my puzzle with no fear.|At puzzles I rank you quite the best,|now enter the portal for your next test.");
    return;
}
@rd_itchood_talk;

[proc,rd_itchood_clue]()(int)
return(modulo(%rd_templock_1, 8));

[label,rd_itchood_talk]
if (~rd_itchood_clue = 0) {
    %rd_templock_1 = ~random_range(1, 6);
}
~chatnpc("<p,happy>Greetings friend, and welcome here,|you'll find my puzzle not so clear.|Hidden amongst my words, it's true,|the password for the door as a clue.");
if (%rd_templock_1 >= 8) {
    switch_int (~p_choice2("Can I have the clue for the door?", 1, "Can I have the final clue?", 2)) {
        case 1 :
            ~chatplayer("<p,quiz>Can I have the clue for the door?");
            ~rd_itchood_first;
        case 2 :
            ~chatplayer("<p,confused>I don't get that riddle...|Can I have the final clue for the door?");
            ~rd_itchood_final;
    }
    return;
}
switch_int (~p_choice2("Can I have the clue for the door?", 1, "Can I have a different clue?", 2)) {
    case 1 :
        ~chatplayer("<p,quiz>Can I have the clue for the door?");
        ~rd_itchood_first;
    case 2 :
        ~chatplayer("<p,confused>I don't get that riddle...|Can I have a different one?");
        %rd_templock_1 = calc(~rd_itchood_clue + 8);
        ~rd_itchood_second;
}

[proc,rd_itchood_first]
switch_int (~rd_itchood_clue) {
    case 1 : ~chatnpc("<p,happy>Better than me, you'll not find|In rhyming and in puzzles.|This clue so clear will tax your mind|Entirely as it confuzzles!");
    case 2 : ~chatnpc("<p,happy>This riddle of mine may confuse,|I am quite sure of that.|Mayhap you should closely peruse|Every word i have spat?");
    case 3 : ~chatnpc("<p,happy>Feel the aching of your mind|In puzzlement, confused.|See the clue hidden behind|His words, as you perused.");
    case 4 : ~chatnpc("<p,happy>More than words, i have not for you|Except the things i say today.|Aware are you, this is a clue?|Take note of what i say!");
    case 5 : ~chatnpc("<p,happy>Look closely at the words i speak;|And study closely every part.|See for yourself the word you seek|Trapped for you if you're smart.");
    case 6 : ~chatnpc("<p,happy>Rare it is that you will see|A puzzle such as this!|In many ways it tickles me|Now, watching you hit and miss!");
}

[proc,rd_itchood_second]
switch_int (~rd_itchood_clue) {
    case 1 : ~chatnpc("<p,happy>Before you hurry through that door|Inspect the words i spoke.|There is a simple hidden flaw|Ere you think my rhyme a joke.");
    case 2 : ~chatnpc("<p,happy>Twice it is now, i have stated|In a rhyme, what is the pass.|Maybe my words obfuscated|Entirely beyond your class.");
    case 3 : ~chatnpc("<p,happy>First my clue you did not see,|I really wish you had.|Such puzzling wordplay devilry|Has left you kind of mad!");
    case 4 : ~chatnpc("<p,happy>Many types have passed through here|Even such as you amongst their sort.|And in the end, the puzzles clear;|The hidden word you saught.");
    case 5 : ~chatnpc("<p,happy>Last time my puzzle did not help|Apparently, so you've bidden.|Study my speech carefully, whelp|To find the answer, hidden.");
    case 6 : ~chatnpc("<p,happy>Repetition, once again|Against good sense it goes.|In my words, the answers plain|Now that you see rhyme flows.");
}

[proc,rd_itchood_final]
switch_int (~rd_itchood_clue) {
    case 1 : ~chatnpc("<p,happy>Betrayed by words the answer is|In that what i say is the key|There is no more help after this|Especially no more from me.");
    case 2 : ~chatnpc("<p,happy>Three times now, my riddle said;|I hope you finally see the clue.|Maybe think on what you've read;|Easy when you know what to do.");
    case 3 : ~chatnpc("<p,happy>For the last time i will state|In simple words, the clue.|Such tricky words make you irate|Having no idea what to do...");
    case 4 : ~chatnpc("<p,happy>Maybe i will do my best;|Especially at giving clues.|Attempt to help you pass the test!|That should help me pay my dues.");
    case 5 : ~chatnpc("<p,happy>Lo! my final speech is now|Attended to by you.|Study my words, and find out how|To understand my clue!");
    case 6 : ~chatnpc("<p,happy>Repeat myself to give the clue|Again, i now do speak.|It's hidden in my words - hey you!|Now find the answer you seek.");
}

[proc,rd_itchood_word](int $clue)(int)
switch_int ($clue) {
    case 1 : return(~rd_combolock_code(1, 8, 19, 4));
    case 2 : return(~rd_combolock_code(19, 8, 12, 4));
    case 3 : return(~rd_combolock_code(5, 8, 18, 7));
    case 4 : return(~rd_combolock_code(12, 4, 0, 19));
    case 5 : return(~rd_combolock_code(11, 0, 18, 19));
    case default : return(~rd_combolock_code(17, 0, 8, 13));
}

[proc,rd_combolock_code](int $a, int $b, int $c, int $d)(int)
return(calc($a + $b * 32 + $c * 1024 + $d * 32768));

[proc,rd_combolock_letter](int $index)(int)
return(modulo(divide(%rd_combolock_letters, pow(32, $index)), 32));

[label,rd_combolock_open]
%rd_combolock_letters = 0;
if_settext(rd_combolock:rda, "A");
if_settext(rd_combolock:rdb, "A");
if_settext(rd_combolock:rdc, "A");
if_settext(rd_combolock:rdd, "A");
if_openmain(rd_combolock);

[proc,rd_combolock_turn](int $index, int $change)
def_int $old = ~rd_combolock_letter($index);
def_int $new = modulo(calc($old + $change + 26), 26);
def_int $mul = pow(32, $index);
%rd_combolock_letters = calc(%rd_combolock_letters - $old * $mul + $new * $mul);
def_string $letter = enum(int, string, rd_letters, $new);
switch_int ($index) {
    case 0 : if_settext(rd_combolock:rda, $letter);
    case 1 : if_settext(rd_combolock:rdb, $letter);
    case 2 : if_settext(rd_combolock:rdc, $letter);
    case default : if_settext(rd_combolock:rdd, $letter);
}

[if_button,rd_combolock:rda_left] ~rd_combolock_turn(0, -1);
[if_button,rd_combolock:rda_right] ~rd_combolock_turn(0, 1);
[if_button,rd_combolock:rdb_left] ~rd_combolock_turn(1, -1);
[if_button,rd_combolock:rdb_right] ~rd_combolock_turn(1, 1);
[if_button,rd_combolock:rdc_left] ~rd_combolock_turn(2, -1);
[if_button,rd_combolock:rdc_right] ~rd_combolock_turn(2, 1);
[if_button,rd_combolock:rdd_left] ~rd_combolock_turn(3, -1);
[if_button,rd_combolock:rdd_right] ~rd_combolock_turn(3, 1);

[if_button,rd_combolock:rdenter]
if_close;
if (npc_find(coord, rd_observer_room_5, 15, 0) = false) {
    return;
}
if (%rd_combolock_letters = ~rd_itchood_word(~rd_itchood_clue)) {
    %rd_room5_complete = ^true;
    ~chatnpc("<p,happy>Your wit is sharp, your brains quite clear;|You solved my puzzle with no fear.|At puzzles I rank you quite the best,|now enter the portal for your next test.");
    return;
}
~chatnpc("<p,sad>It's sad to say,|this test beat you.|I'll send you to Tiffy,|what to do?");
mes("You have failed to solve the riddle.");
@rd_fail;
