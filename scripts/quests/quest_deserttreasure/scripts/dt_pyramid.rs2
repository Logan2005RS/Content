[oplocu,desert_treasure_oblix1] ~fd_place_diamond(fd_blood_diamond, 1);
[oplocu,desert_treasure_oblix2] ~fd_place_diamond(fd_diamond_fire, 2);
[oplocu,desert_treasure_oblix3] ~fd_place_diamond(fd_icediamond, 3);
[oplocu,desert_treasure_oblix4] ~fd_place_diamond(fd_dark_diamond, 4);

[proc,fd_place_diamond](obj $diamond, int $column)
if (last_useitem ! fd_blood_diamond & last_useitem ! fd_diamond_fire & last_useitem ! fd_icediamond & last_useitem ! fd_dark_diamond) {
    ~displaymessage(^dm_default);
    return;
}
if (last_useitem ! $diamond) {
    mes("That doesn't appear to be the correct diamond...");
    return;
}
if (~fd_column_filled($column) = true) {
    mes("Nothing interesting happens.");
    return;
}
if (stat(magic) < 50) {
    mes("You are not a powerful enough mage to breach the protective aura.");
    mes("You need a magic level of at least 50 to enter the Pyramid.");
    return;
}
anim(human_pickuptable, 0);
sound_synth(place_crystal, 0, 0);
inv_del(inv, $diamond, 1);
switch_int ($column) {
    case 1 : %fd_column_blood = 1;
    case 2 : %fd_column_fire = 1;
    case 3 : %fd_column_ice = 1;
    case 4 : %fd_column_shadow = 1;
}
mes("The diamond is absorbed into the pillar.");
if (%fd_column_blood = 1 & %fd_column_fire = 1 & %fd_column_ice = 1 & %fd_column_shadow = 1) {
    mes("The force preventing access to the Pyramid has now vanished.");
    if (%deserttreasure < ^deserttreasure_pyramid_open) {
        %deserttreasure = ^deserttreasure_pyramid_open;
    }
}

[proc,fd_column_filled](int $column)(boolean)
switch_int ($column) {
    case 1 : if (%fd_column_blood = 1) return(true);
    case 2 : if (%fd_column_fire = 1) return(true);
    case 3 : if (%fd_column_ice = 1) return(true);
    case 4 : if (%fd_column_shadow = 1) return(true);
}
return(false);

[oploc1,desert_laddertop] ~fd_pyramid_ladder(human_climbing_down, 3_45_77_33_26);

[oploc1,desert_ladder] ~fd_pyramid_ladder(human_climbing, 0_50_45_33_18);
[oploc1,desert_laddertop3_2] ~fd_pyramid_ladder(human_climbing_down, 2_44_77_30_36);
[oploc1,desert_ladder2_3] ~fd_pyramid_ladder(human_climbing, 3_45_77_29_35);
[oploc1,desert_laddertop2_1] ~fd_pyramid_ladder(human_climbing_down, 1_43_77_30_44);
[oploc1,desert_ladder1_2] ~fd_pyramid_ladder(human_climbing, 2_44_77_29_45);
[oploc1,desert_laddertop1_0]
~fd_pyramid_ladder(human_climbing_down, 0_50_145_33_13);
if (%deserttreasure = ^deserttreasure_pyramid_open) {
    %deserttreasure = ^deserttreasure_azzanadra_freed;
}
[oploc1,desert_ladder0_1] ~fd_pyramid_ladder(human_climbing, 1_43_77_31_13);

[proc,fd_pyramid_ladder](seq $anim, coord $dest)
anim($anim, 0);
p_delay(1);
p_telejump($dest);

[oploc1,desert_trasure_back_door_skew]
if (%deserttreasure < ^deserttreasure_complete) {
    mes("This passage does not seem to lead anywhere...");
    return;
}
p_telejump(0_50_145_33_33);

[oploc1,dia_down]
if (%deserttreasure < ^deserttreasure_complete) {
    return;
}
anim(human_castteleport, 0);
spotanim_pl(zaros_teleport, 0, 0);
p_delay(1);
p_telejump(0_50_45_33_7);

[oploc1,dt_zaros_altar]
anim(human_pray, 0);
if (%deserttreasure < ^deserttreasure_complete) {
    mes("This altar seems to do nothing...");
    if (%deserttreasure = ^deserttreasure_pyramid_open) {
        %deserttreasure = ^deserttreasure_azzanadra_freed;
    }
    return;
}
sound_synth(prayer_recharge, 0, 0);
stat_sub(prayer, stat(prayer), 0);
~player_autocast_reset;
if (%zaros_spellbook = 1) {
    %zaros_spellbook = 0;
    mes("You feel a strange drain upon your memory...");
} else {
    %zaros_spellbook = 1;
    mes("You feel a strange wisdom fill your mind...");
}
~settab_magic;
if_settabactive(^tab_magic);

[opnpc1,azzanadra]
if (%deserttreasure = ^deserttreasure_complete) {
    return;
}
%deserttreasure = ^deserttreasure_spoken_azzanadra;
~chatnpc("<p,happy>I knew they could not trap me here for long! Well done, friend. Tell me, how goes the war?");
~chatplayer("<p,confused>War?");
~chatnpc("<p,shock>You do not know of the war for our survival? More time must have passed than I had thought...");
~chatnpc("<p,quiz>Tell me, what news of great Paddewwa? Do the shining spires of Lassar still stand? And what of glorious Annakarl? The fortress is still intact?");
~chatplayer("<p,confused>Er... sorry, I've never heard of them...");
~chatnpc("<p,sad>No! My lord... what has become of you? I cannot hear your voice anymore!");
~chatnpc("<p,sad>My thanks to you friend for your help in freeing me from this accursed place, but it seems I have much to do to make amends. If our empire no longer stands, it means that we must have failed my lord...");
~chatnpc("<p,sad>How long have I been trapped here? Master... have you truly been dispatched from this world?");
~chatnpc("<p,neutral>My friend, for your efforts in freeing me, I offer you the gift of knowledge. We Mahjarrat were once granted powerful ancient magicks by our lord. I now bestow their power upon you.");
~chatnpc("<p,neutral>They will replace the knowledge you previously had, but you may switch between them by praying at the altar in this room at any time. May you use them well.");
~chatnpc("<p,neutral>I trust that we shall meet again, but now I must leave you. Feel free to use the portal I shall create to return here easily in the future!");
queue(deserttreasure_quest_complete, 0, 0);

[queue,deserttreasure_quest_complete]
if (%deserttreasure ! ^deserttreasure_spoken_azzanadra) {
    return;
}
%deserttreasure = ^deserttreasure_complete;
%zaros_spellbook = 1;
~player_autocast_reset;
~settab_magic;
stat_advance(magic, 200069);
session_log(^log_adventure, "Quest complete: Desert Treasure");
~send_quest_complete(questlist:deserttreasure, staff_of_zaros, 200, ^deserttreasure_questpoints, "You have completed\\nDesert Treasure!");
~chatplayer("<p,neutral>I should go and let Eblis know what's happened here...");

[mapzone,0_45_77] ~fd_pyramid_start; @music_playbyregion(coord);
[mapzone,0_44_77] ~fd_pyramid_start; @music_playbyregion(coord);
[mapzone,0_43_77] ~fd_pyramid_start; @music_playbyregion(coord);
[mapzone,0_50_145] ~fd_pyramid_start; @music_playbyregion(coord);

[proc,fd_in_pyramid_upper](coord $coord)(boolean)
if (inzone(3_45_77_0_0, 3_45_77_63_63, $coord) = true | inzone(2_44_77_0_0, 2_44_77_63_63, $coord) = true | inzone(1_43_77_0_0, 1_43_77_63_63, $coord) = true) {
    return(true);
}
return(false);

[proc,fd_in_pyramid](coord $coord)(boolean)
if (~fd_in_pyramid_upper($coord) = true | inzone(0_50_145_0_0, 0_50_145_63_63, $coord) = true) {
    return(true);
}
return(false);

[proc,fd_stepped]()(boolean)
if (coord = %fd_step_coord) {
    return(false);
}
%fd_step_coord = coord;
return(true);

[proc,fd_pyramid_start]
if (~fd_in_pyramid(coord) = false) {
    return;
}
%fd_step_coord = coord;
if (gettimer(fd_pyramid) = 0) {
    settimer(fd_pyramid, 1);
}

[timer,fd_pyramid]
if (~fd_in_pyramid(coord) = false) {
    cleartimer(fd_pyramid);
    return;
}
if (stat(hitpoints) = 0 | ~fd_stepped = false) {
    return;
}
if (inzone(0_50_145_27_30, 0_50_145_39_40, coord) = true) {
    return;
}
if (random(20) = 0) {
    def_coord $sarcophagus = ~fd_near_sarcophagus(coord);
    if ($sarcophagus ! null) {
        @fd_pyramid_mummy($sarcophagus);
    }
}
if (random(80) = 0) {
    @fd_pyramid_scarabs;
}
if (~fd_in_pyramid_upper(coord) = true & random(128) = 0) {
    if (random(995) > multiply(add(stat(agility), stat(thieving)), 5)) {
        @fd_pyramid_trap;
    }
}

[proc,fd_near_sarcophagus](coord $coord)(coord)
def_int $i = 0;
def_int $count = db_getfieldcount(fd_sarcophagi, fd_sarcophagus_table:coord);
while ($i < $count) {
    def_coord $sarcophagus = db_getfield(fd_sarcophagi, fd_sarcophagus_table:coord, $i);
    if (coordy($sarcophagus) = coordy($coord) & distance($sarcophagus, $coord) <= 3) {
        return($sarcophagus);
    }
    $i = add($i, 1);
}
return(null);

[label,fd_pyramid_trap]
p_stopaction;
mes("You accidentally trigger a trap...");
loc_add(coord, deserttreasure_pitfall_animated, 0, centrepiece_straight, 6);
sound_synth(pitfall, 0, 0);
anim(desert_comedy_fall, 0);
p_delay(3);
spotanim_map(comedy_smoke_fall, coord, 0, 0);
~fade_out;
p_delay(2);
p_telejump(0_50_45_33_7);
mes("...and tumble unharmed outside the pyramid.");
~fade_in;
queue(fade_clear, 2, 0);

[label,fd_pyramid_scarabs]
if (npc_find(coord, scarab_swarm, 6, 0) = true) {
    return;
}
def_coord $spawn = map_findsquare(coord, 1, 3, ^map_findsquare_lineofwalk);
if ($spawn = null) {
    return;
}
p_stopaction;
spotanim_map(deserttreasure_cracks_floor_spotanim, $spawn, 0, 0);
sound_synth(scarabs_appear, 0, 0);
p_delay(2);
npc_add($spawn, scarab_swarm, 100);
npc_anim(scarab_spiral, 0);
npc_setmode(opplayer2);

[label,fd_pyramid_mummy](coord $sarcophagus)
if (npc_find(coord, deserttreasure_mummy_1, 5, 0) = true) {
    return;
}
def_coord $spawn = map_findsquare($sarcophagus, 1, 1, ^map_findsquare_lineofwalk);
if ($spawn = null) {
    return;
}
~fd_open_sarcophagus($sarcophagus);
p_stopaction;
sound_synth(mummy_appear, 0, 0);
npc_add($spawn, deserttreasure_mummy_1, 100);
npc_say("Rawr!");
p_delay(1);
npc_setmode(opplayer2);

[proc,fd_open_sarcophagus](coord $sarcophagus)
if (loc_find($sarcophagus, deserttreasure_sarcophigi_door) = true) {
    loc_change(deserttreasure_sarcophigi_door_inac, 5);
} else if (loc_find($sarcophagus, deserttreasure_sarcophigi_door_2) = true) {
    loc_change(deserttreasure_sarcophigi_door_inac2, 5);
} else if (loc_find($sarcophagus, deserttreasure_sarcophigi_door_3) = true) {
    loc_change(deserttreasure_sarcophigi_door_inac3, 5);
} else if (loc_find($sarcophagus, deserttreasure_sarcophigi_door_4) = true) {
    loc_change(deserttreasure_sarcophigi_door_inac4, 5);
} else if (loc_find($sarcophagus, deserttreasure_sarcophigi_door_5) = true) {
    loc_change(deserttreasure_sarcophigi_door_inac5, 5);
} else if (loc_find($sarcophagus, deserttreasure_sarcophigi_door_6) = true) {
    loc_change(deserttreasure_sarcophigi_door_inac6, 5);
}

[oploc1,_fd_sarcophagus]
mes("You don't find anything interesting.");

[oploc1,four_diamonds_door_1] @fd_pyramid_entrance;
[oploc1,four_diamonds_door_mirror] @fd_pyramid_entrance;

[label,fd_pyramid_entrance]
if (coordz(coord) < coordz(loc_coord)) {
    sound_synth(door_open, 0, 0);
    p_telejump(movecoord(coord, 0, 0, 2));
    return;
}
if (%deserttreasure < ^deserttreasure_pyramid_open) {
    mes("A mystical power has sealed this door...");
    return;
}
sound_synth(door_open, 0, 0);
p_telejump(movecoord(coord, 0, 0, -2));

[oploc1,dt_ancient_temple_door_open] @fd_temple_door;
[oploc1,dt_ancient_temple_door_open_mirror] @fd_temple_door;

[label,fd_temple_door]
sound_synth(door_open, 0, 0);
if (coordz(coord) < coordz(loc_coord)) {
    p_telejump(movecoord(coord, 0, 0, 2));
    return;
}
p_telejump(movecoord(coord, 0, 0, -2));
