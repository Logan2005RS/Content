[opnpc1,ahoy_akharanu_multi]
if (%ahoy_subquest_bow = ^ahoy_bow_given) {
    if (%ahoy_given_manual = ^false & ~obj_gettotal(ahoy_translation_manual) = 0) {
        ~chatplayer("<p,sad>I'm sorry, I seem to have lost the translation manual you gave me.");
        ~chatnpc("<p,happy>Ah, no worry, my friend. For the gift of longbow Ak-Haranu would give a thousand books.");
        ~ahoy_give(ahoy_translation_manual);
        ~objbox(ahoy_translation_manual, "Ak-Haranu gives you another translation manual.", 250, 0, 0);
        return;
    }
    ~chatplayer("<p,happy>Thank you for the translation manual, Ak-Haranu - it may save many souls before long.");
    ~chatnpc("<p,happy>And Ak-Haranu thanks you for kind gift of longbow.");
    return;
}
if (%ahoy_subquest_bow = ^ahoy_bow_signed & inv_total(inv, oak_longbow_signed) > 0) {
    @ahoy_akharanu_reward;
}
if (%ahoy_questvar ! ^ahoy_gather_items) {
    ~chatplayer("<p,happy>It's nice to see a human face around here.");
    ~chatnpc("<p,happy>My name Ak-Haranu. I am trader, come from many far across sea in east.");
    ~chatplayer("<p,quiz>You come from the lands of the East?");
    ~chatnpc("<p,happy>Yes, would you like buy Eastern gifts?");
    switch_int (~p_choice2("I'd like to see what you have for sale.", 1, "No thanks.", 2)) {
        case 1 : ~openshop_activenpc;
        case 2 : ~chatplayer("<p,neutral>No thanks.");
    }
    return;
}
if (%ahoy_subquest_bow >= ^ahoy_bow_spoken_akharanu) {
    if (inv_total(inv, oak_longbow) = 0) {
        ~chatplayer("<p,quiz>Have you got an oak longbow that I can get Robin to sign for you?");
        ~chatnpc("<p,sad>No, Ak-Haranu afraid that no longbow in supply at moment. You must make one or buy one.");
        return;
    }
    ~chatnpc("<p,quiz>How Master <displayname()> getting on with longbow?");
    ~chatplayer("<p,neutral>I'll let you know.");
    return;
}
~chatplayer("<p,happy>It's nice to see a human face around here.");
~chatnpc("<p,happy>My name Ak-Haranu. I am trader, come from many far across sea in east.");
~chatplayer("<p,quiz>You come from the lands of the East? Do you have anything that can help me translate a book that is scribed in your language?");
~chatnpc("<p,shifty>Ak-Haranu may help you. A translation manual I have, much good for reading Eastern language.");
~chatplayer("<p,quiz>How much do you want for it?");
~chatnpc("<p,neutral>Ak-Haranu not want money for this book, as is such small thing. But there may be something you could do for me. I am big admirer of Robin, Master Bowman. He staying in village inn.");
~chatplayer("<p,quiz>What would you like me to do?");
~chatnpc("<p,happy>Please get Master Bowman sign an oak longbow for me, so Ak-Haranu can show family and friends when returning home and become much admired. Then I give you book in exchange.");
switch_int (~p_choice2("Okay, wait here - I'll get you your bow.", 1, "Sorry, I have too much to do at the moment.", 2)) {
    case 1 :
        ~chatplayer("<p,happy>Okay, wait here - I'll get you your bow.");
        %ahoy_subquest_bow = ^ahoy_bow_spoken_akharanu;
    case 2 : ~chatplayer("<p,neutral>Sorry, I have too much to do at the moment.");
}

[opnpcu,ahoy_akharanu_multi]
if (last_useitem = oak_longbow_signed & %ahoy_subquest_bow = ^ahoy_bow_signed) {
    @ahoy_akharanu_reward;
}
~displaymessage(^dm_default);

[label,ahoy_akharanu_reward]
~chatplayer("<p,happy>I have your signed longbow for you.");
~chatnpc("<p,shock>Ah, can it be true? You have obtained bow from Master Bowman?");
~chatplayer("<p,shifty>He was more than happy to oblige (cough). Here you are.");
inv_del(inv, oak_longbow_signed, 1);
~ahoy_give(ahoy_translation_manual);
%ahoy_subquest_bow = ^ahoy_bow_given;
~objbox(ahoy_translation_manual, "Ak-Haranu gives you a translation manual in return for the signed oak longbow.", 250, 0, 0);
~chatnpc("<p,happy>May honour be bestowed upon you and your family!");

[opnpc1,ahoy_robin]
if (%ahoy_questvar = ^ahoy_gather_items & %ahoy_subquest_bow >= ^ahoy_bow_spoken_akharanu & %ahoy_subquest_bow <= ^ahoy_bow_owed_100) {
    @ahoy_robin_runedraw;
}
if (%ahoy_subquest_bow >= ^ahoy_bow_signed | %ahoy_questvar = ^ahoy_complete) {
    ~chatplayer("<p,neutral>So, still here then?");
    ~chatnpc("<p,quiz>Do you want another game of Runedraw?");
    ~chatplayer("<p,angry>No!");
    return;
}
if (inv_total(inv, ahoy_bedsheet) > 0) {
    ~chatplayer("<p,neutral>I've brought you a clean bedsheet, Robin.");
    inv_del(inv, ahoy_bedsheet, 1);
    ~chatnpc("<p,neutral>Well it's about time. Run along now, I need some Robin time.");
    return;
}
~chatplayer("<p,happy>It's nice to see another human face around here.");
~chatnpc("<p,angry>Leave me be, peasant - I am relaxing.");
~chatplayer("<p,neutral>Well, that's nice!");
~chatnpc("<p,quiz>Do you know who I am?");
~chatplayer("<p,neutral>I'm sorry, I haven't had the privilege.");
~chatnpc("<p,happy>I, peasant, am Robin, Master Bowman. I am very famous you know.");
~chatplayer("<p,neutral>Oh, Robin, Master Bowman, I see.");
~chatnpc("<p,quiz>So have you heard of me?");
~chatplayer("<p,neutral>No.");
~chatnpc("<p,neutral>Would you do me a favour? I appear to have run out of bed linen. Can you run along to the innkeeper and get me a clean bedsheet?");
%ahoy_requested_sheet = ^true;
switch_int (~p_choice2("Anything for a famous person such as yourself.", 1, "Go and get it yourself.", 2)) {
    case 1 :
        ~chatplayer("<p,happy>Anything for a famous person such as yourself.");
        ~chatnpc("<p,happy>Now that sounds more like it. Run along now, get me my sheet.");
    case 2 :
        ~chatplayer("<p,angry>Go and get it yourself.");
        ~chatnpc("<p,angry>Oh charming. You just can't get the staff these days.");
}

[label,ahoy_robin_runedraw]
def_int $owed = multiply(calc(%ahoy_subquest_bow - ^ahoy_bow_spoken_akharanu), 25);
if (%ahoy_subquest_bow = ^ahoy_bow_owed_100) {
    if (inv_total(inv, oak_longbow) = 0) {
        ~chatplayer("<p,neutral>I should get a longbow for Robin to sign before talking to him.");
        return;
    }
    ~chatplayer("<p,angry>I've had enough of you not paying up - you owe me 100 gold coins. I'm going to tell the ghosts what you're doing.");
    ~chatnpc("<p,scared>Please don't do that!!! They will suck the life from my bones!!!");
    ~chatplayer("<p,quiz>How about you signing my longbow then?");
    ~chatnpc("<p,scared>Yes, anything!!!");
    inv_del(inv, oak_longbow, 1);
    inv_add(inv, oak_longbow_signed, 1);
    %ahoy_subquest_bow = ^ahoy_bow_signed;
    ~objbox(oak_longbow_signed, "Robin signs the oak longbow for you.", 250, 0, 0);
    return;
}
if ($owed > 0) {
    if (%runedraw_won_last_game = ^true) {
        ~chatplayer("<p,angry>So are you going to pay up then? You owe me <tostring($owed)> gold coins!");
        ~chatnpc("<p,shifty>How about another game? I'll pay you back with the winnings.");
        ~chatplayer("<p,quiz>What if you lose again?");
        ~chatnpc("<p,shifty>Er ... we'll deal with that when we come to it.");
    } else {
        ~chatplayer("<p,neutral>Well done, you beat me. But you still owe me <tostring($owed)> gold pieces.");
        ~chatnpc("<p,shifty>Err ... how about another game? We can settle up after we've finished playing.");
    }
    @ahoy_robin_game_options("No, you didn't pay up the last time you lost.");
}
if (inv_total(inv, oak_longbow) > 0) {
    ~chatplayer("<p,quiz>Would you sign this oak longbow for me?");
    ~chatnpc("<p,neutral>I'm sorry, I don't sign autographs. While you're here though, why don't you have a game of Runedraw with me? If you've got 25 gold pieces I've got a bag of runes we can use.");
} else {
    ~chatnpc("<p,neutral>Hey you, why don't you have a game of Runedraw with me? If you've got 25 gold pieces I've got a bag of runes we can use.");
}
if (inv_total(inv, coins) < ^ahoy_runedraw_stake) {
    ~chatplayer("<p,sad>I don't have enough money on me for a game of Runedraw at the moment.");
    return;
}
@ahoy_robin_game_options("No, that doesn't sound fun.");

[label,ahoy_robin_game_options](string $decline)
switch_int (~p_choice3("Yes, I'll give you a game.", 1, "How do you play Runedraw?", 2, $decline, 3)) {
    case 1 :
        ~chatplayer("<p,happy>Yes, I'll give you a game.");
        @runedraw_start;
    case 2 :
        ~chatplayer("<p,quiz>How do you play Runedraw?");
        ~chatnpc("<p,neutral>Two players take turns to draw a rune from a bag, which contains ten runes in total. Each rune has a different value: an air rune is worth one point, up to a Nature rune which is worth nine points.");
        ~chatnpc("<p,neutral>If a player draws the Death rune then the game is over, and they have lost.");
        ~chatnpc("<p,neutral>A player can choose to hold if they wish and not draw any more runes, but this runs the risk of the other player drawing more runes until they have a greater points total and win.");
    case 3 : ~chatplayer("<p,neutral><$decline>");
}
