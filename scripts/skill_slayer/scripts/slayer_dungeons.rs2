[oploc1,slayertower_door] @slayer_tower_entrance;
[oploc1,slayertower_door_mirror] @slayer_tower_entrance;
[oploc1,slayertower_door_arch] @slayer_tower_entrance;
[oploc1,slayertower_door_arch_mirror] @slayer_tower_entrance;

[label,slayer_tower_entrance]
p_arrivedelay;
sound_synth(slayerdoors, 1, 0);
~slayer_tower_statue(0_53_55_34_14);
~slayer_tower_statue(0_53_55_38_14);
if (coordz(coord) > coordz(loc_coord)) {
    p_teleport(movecoord(coord, 0, 0, -1));
} else {
    p_teleport(movecoord(coord, 0, 0, 1));
}

[proc,slayer_tower_statue](coord $coord)
if (loc_find($coord, slayer_gargoyle_statue) = true) {
    loc_anim(gargoyle_statue_open);
    sound_synth(slayer_statuemove, 1, 0);
}

[oploc1,loc_5126]
p_arrivedelay;
sound_synth(slayerdoors, 1, 0);
if (coordz(coord) > coordz(loc_coord)) {
    p_teleport(movecoord(coord, 0, 0, -1));
} else {
    p_teleport(movecoord(coord, 0, 0, 1));
}

[oploc1,loc_5127]
~mesbox("@red@WARNING!|This area contains very dangerous creatures!|Do not pass unless properly prepared!");

[oploc1,loc_4493]
p_arrivedelay;
p_telejump(1_53_55_41_17);

