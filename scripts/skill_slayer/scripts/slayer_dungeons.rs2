[oploc1,swamp_cave_steppingstone_a] @slayer_stepping_stone;
[oploc1,swamp_cave_steppingstone_b] @slayer_stepping_stone;

[label,slayer_stepping_stone]
def_int $dx = 0;
def_int $dz = 0;
if (coordx(coord) < coordx(loc_coord)) {
    $dx = 1;
} else if (coordx(coord) > coordx(loc_coord)) {
    $dx = -1;
}
if (coordz(coord) < coordz(loc_coord)) {
    $dz = 1;
} else if (coordz(coord) > coordz(loc_coord)) {
    $dz = -1;
}
anim(human_steppingstonejump, 0);
p_delay(0);
p_teleport(loc_coord);
p_delay(0);
anim(human_steppingstonejump, 0);
p_delay(0);
p_teleport(movecoord(loc_coord, $dx, 0, $dz));

