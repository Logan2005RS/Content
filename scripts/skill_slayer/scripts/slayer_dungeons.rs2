[oploc1,loc_9319]
def_int $level = 61;
if (coordy(loc_coord) > 0) {
    $level = 71;
}
if (stat(agility) < $level) {
    mes("You need an Agility level of at least <tostring($level)> in order to do this.");
    return;
}
anim(human_reachforladdertop, 0);
p_delay(0);
p_telejump(movecoord(coord, 0, 1, 0));

[oploc1,loc_9320]
anim(human_reachforladder, 0);
p_delay(0);
p_telejump(movecoord(coord, 0, -1, 0));

[oploc1,slayer_dungeon_entrance]
p_arrivedelay;
p_telejump(0_43_156_56_18);

[oploc1,slayer_dungeon_exit]
p_arrivedelay;
p_telejump(0_43_56_44_31);

[oploc1,slayer_dungeon_2_sc_wall_crack]
if (stat(agility) < 62) {
    mes("You need an Agility level of at least 62 to do this.");
    return;
}
def_int $dx = 4;
if (coordx(coord) > coordx(loc_coord)) {
    $dx = -4;
}
anim(human_pipesqueeze, 0);
p_delay(1);
p_teleport(movecoord(loc_coord, $dx, 0, 0));
anim(human_pipeunsqueeze, 0);
mes("You climb your way through the narrow crevice.");

[oploc1,loc_9326]
if (stat(agility) < 81) {
    mes("You need an Agility level of at least 81 to do this.");
    return;
}
def_int $dx = 0;
def_int $dz = 0;
if (coordx(coord) < coordx(loc_coord)) {
    $dx = 1;
} else if (coordx(coord) > coordx(loc_coord)) {
    $dx = -1;
}
if (coordz(coord) < coordz(loc_coord)) {
    $dz = 1;
} else if (coordz(coord) > coordz(loc_coord)) {
    $dz = -1;
}
anim(human_longjump, 0);
p_delay(0);
p_teleport(movecoord(loc_coord, $dx, 0, $dz));
if (stat_random(agility, 180, 250) = false) {
    mes("You trigger the trap as you jump over it.");
    ~damage_self(randominc(6));
}

