[oploc1,dagannoth_caveentrance_rock]
if (~p_choice2_header("Go in, I don't mind dying!", 1, "No I'm holding too much stuff!", 2, "DANGER! High risk of death!") = 1) {
    p_telejump(^waterbirth_dungeon_entrance);
}

[oploc1,dagannoth_rocky_steps]
p_telejump(^waterbirth_dungeon_exit);

[oploc1,dagannoth_ladder_base_ext2] @ladder_options(^waterbirth_mountain_top, ^waterbirth_sublevel_entrance);
[oploc2,dagannoth_ladder_base_ext2] ~climb_ladder(^waterbirth_mountain_top, true);
[oploc3,dagannoth_ladder_base_ext2] ~climb_ladder(^waterbirth_sublevel_entrance, false);

[oploc1,dagexp_entrance_ladder] ~climb_ladder(^waterbirth_dungeon_ladder, true);

[oploc1,dagexp_bossroomladder_down] ~climb_ladder(^waterbirth_kings_lair, false);
[oploc1,dagexp_bossroomladder_up] ~climb_ladder(^waterbirth_kings_lair_exit, true);

[oploc1,dagexp_ladder1] ~climb_ladder(2_28_68_18_53, false);
[oploc1,dagexp_ladder2] ~climb_ladder(3_28_68_15_53, true);
[oploc1,dagexp_ladder3] ~climb_ladder(2_28_68_30_52, false);
[oploc1,dagexp_ladder4] ~climb_ladder(3_28_68_33_52, true);
[oploc1,dagexp_ladder5] ~climb_ladder(2_28_68_42_35, false);
[oploc1,dagexp_ladder6] ~climb_ladder(3_28_68_42_38, true);
