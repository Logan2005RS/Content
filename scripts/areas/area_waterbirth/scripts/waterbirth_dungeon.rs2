[oploc1,dagannoth_pressure_door] @dagannoth_pressure_door_open;
[oploc1,dagannoth_pressure_door2] @dagannoth_pressure_door_open;
[oploc1,dagannoth_pressure_door3] @dagannoth_pressure_door_open;

[label,dagannoth_pressure_door_open]
if (coordx(coord) < coordx(^waterbirth_pressure_door_behind)) {
    if (~dagannoth_pressure_pad_held(movecoord(loc_coord, -1, 0, 0)) = false | ~dagannoth_pressure_pad_held(movecoord(loc_coord, -1, 0, 2)) = false) {
        mes("You cannot see a way to open this door...");
        return;
    }
}
sound_synth(dagganoth_pressure_door_open, 1, 0);
loc_change(dagannoth_pressure_opening2, 30);

[proc,dagannoth_pressure_pad_held](coord $pad)(boolean)
if (map_playercount($pad, $pad) > 0) {
    return(true);
}
if (obj_find($pad, vt_useless_rock) = true) {
    return(true);
}
return(false);

[proc,dagannoth_door_support_attackable](boolean $magic)(boolean)
if (npc_range(coord) <= 3) {
    mes("The door is propped securely shut from this side...");
    return(false);
}
if ($magic = false & %damagetype ! ^ranged_style) {
    mes("The door is propped securely shut from this side...");
    return(false);
}
return(true);

[opnpc2,_dagannoth_door_support]
if (~dagannoth_door_support_facing = true) {
    mes("The door is propped securely shut from this side...");
    return;
}
@player_combat_start;

[apnpc2,_dagannoth_door_support]
if (~dagannoth_door_support_facing = true) {
    mes("The door is propped securely shut from this side...");
    return;
}
@player_combat_start_ap;

[proc,dagannoth_door_support_facing]()(boolean)
if (npc_type = dagannoth_weak_door_north & coordz(coord) > coordz(npc_coord)) {
    return(true);
}
if (npc_type = dagannoth_weak_door_west & coordx(coord) < coordx(npc_coord)) {
    return(true);
}
if (npc_type = dagannoth_weak_door_south & coordz(coord) < coordz(npc_coord)) {
    return(true);
}
return(false);

[ai_queue1,_dagannoth_door_support] return;

[ai_queue2,_dagannoth_door_support]
if (npc_stat(hitpoints) = 0) {
    return;
}
npc_damage(^hitmark_damage, 1);
~sound_area(support_death, 0, npc_coord, 10);
if (loc_find(npc_coord, dagcave_invisibleblocking) = true) {
    loc_del(57);
}
switch_npc (npc_type) {
    case dagannoth_weak_door_north : npc_changetype(dagannoth_weak_door_falling_north, 57);
    case dagannoth_weak_door_west : npc_changetype(dagannoth_weak_door_falling_west, 57);
    case dagannoth_weak_door_south : npc_changetype(dagannoth_weak_door_falling_south, 57);
}
npc_queue(4, 0, 2);

[ai_queue4,dagannoth_weak_door_falling_north] npc_changetype(dagannoth_weak_door_fallen_north, 55);
[ai_queue4,dagannoth_weak_door_falling_west] npc_changetype(dagannoth_weak_door_fallen_west, 55);
[ai_queue4,dagannoth_weak_door_falling_south] npc_changetype(dagannoth_weak_door_fallen_south, 55);

[zone,0_39_158_48_24] settimer(waterbirth_eggs, 1);
[zone,0_39_158_48_32] settimer(waterbirth_eggs, 1);

[timer,waterbirth_eggs]
if (inzone(0_39_158_48_24, 0_39_158_55_39, coord) = false) {
    cleartimer(waterbirth_eggs);
    return;
}
if (coord ! ^waterbirth_egg_trigger_north & coord ! ^waterbirth_egg_trigger_south) {
    return;
}
def_boolean $hatching = false;
if (npc_findexact(^waterbirth_egg_north, dungeon_dagganoth_egg1) = true) {
    npc_changetype(dungeon_dagganoth_egg2, 45);
    $hatching = true;
}
if (npc_findexact(^waterbirth_egg_south, dungeon_dagganoth_egg1) = true) {
    npc_changetype(dungeon_dagganoth_egg2, 45);
    $hatching = true;
}
if ($hatching = true) {
    queue(waterbirth_eggs_hatch, 2, 0);
}

[queue,waterbirth_eggs_hatch]
~waterbirth_egg_hatch(^waterbirth_egg_north);
~waterbirth_egg_hatch(^waterbirth_egg_south);

[proc,waterbirth_egg_hatch](coord $egg)
if (npc_findexact($egg, dungeon_dagganoth_egg2) = false) {
    return;
}
npc_changetype(dungeon_dagganoth_egg3, 43);
npc_anim(dagganoth_egg_open, 0);
sound_synth(dagganoth_egg_open, 1, 0);
npc_add(movecoord($egg, -1, 0, 0), dagganoth_critter, 45);
%aggressive_npc = npc_uid;
npc_setmode(opplayer2);

[proc,waterbirth_snow_overlay]
if_openoverlay(overlay_atmosphere_snow_flakes);

[proc,waterbirth_clear_overlay]
if (inzone(^waterbirth_island_lower_bound, ^waterbirth_island_upper_bound, coord) = false) {
    if_openoverlay(null);
}
