loc_change(ahoy_trapdoor, 500);

[oploc1,ahoy_ladder_from_cellar] ~climb_ladder(0_57_54_6_63, true);

[oploc1,ahoy_cavern_stairs]
p_arrivedelay;
switch_int (coordy(coord)) {
