[proc,ahoy_ghostspeak]()(boolean)
if (inv_total(worn, amulet_of_ghostspeak) > 0 | inv_total(worn, amulet_of_ghostspeak_enchanted) > 0) {
    return(true);
}
return(false);

[proc,ahoy_ghost_wail]
~chatnpc("<p,neutral>Woooo wooo wooooo woooo");
~mesbox("You cannot understand the ghost.");

[proc,ahoy_in_phasmatys](coord $coord)(boolean)
return(inzone(0_57_54_5_2, 0_57_54_61_51, $coord));

[proc,ahoy_wearing_bedsheet]()(boolean)
if (inv_total(worn, ahoy_bedsheet) > 0 | inv_total(worn, ahoy_bedsheetgreen) > 0) {
    return(true);
}
return(false);

[oploc1,ahoy_town_barrier]
def_coord $inside;
def_coord $outside;
def_boolean $leaving = false;
if (loc_coord = 0_57_54_4_29) {
    $inside = movecoord(loc_coord, 1, 0, 0);
    $outside = movecoord(loc_coord, -1, 0, 0);
    if (coordx(coord) > coordx(loc_coord)) {
        $leaving = true;
    }
} else {
    $inside = movecoord(loc_coord, 0, 0, -1);
    $outside = movecoord(loc_coord, 0, 0, 1);
    if (coordz(coord) < coordz(loc_coord)) {
        $leaving = true;
    }
}
if (~ahoy_wearing_bedsheet = true) {
    ~mesbox("You can't pass the barriers of Port Phasmatys while wearing the bedsheet.");
    return;
}
if ($leaving = true) {
    ~ahoy_pass_barrier($outside);
    return;
}
@ahoy_guard_toll($inside);

[proc,ahoy_pass_barrier](coord $dest)
p_arrivedelay;
~forcemove($dest);

[label,ahoy_guard_toll](coord $inside)
if (~ahoy_ghostspeak = false) {
    if (%ahoy_questvar = ^ahoy_complete) {
        ~mesbox("The ghostly guards wail at you incomprehensibly, and though you cannot understand their exact words you understand their meaning - you may pass the barriers of Port Phasmatys without charge.");
        ~ahoy_pass_barrier($inside);
        return;
    }
    ~mesbox("The ghostly guards wail at you incomprehensibly, and though you cannot understand their exact words you understand their meaning - you may not pass the barriers of Port Phasmatys.");
    return;
}
if (%ahoy_questvar = ^ahoy_complete) {
    ~chatnpc_specific("Ghost guard", ahoy_ghost_guard, "<p,neutral>All visitors to Port Phasmatys must pay a toll charge of 2 Ectotokens. However, you have done the ghosts of our town a service that surpasses all value, so you may pass without charge.");
    ~ahoy_pass_barrier($inside);
    return;
}
~chatnpc_specific("Ghost guard", ahoy_ghost_guard, "<p,neutral>All visitors to Port Phasmatys must pay a toll charge of 2 Ectotokens.");
switch_int (~p_choice3("I would like to enter Port Phasmatys - here's 2 Ectotokens.", 1, "I'm not paying you Ectotokens just to go through a gate.", 2, "Where can I get Ectotokens?", 3)) {
    case 1 :
        ~chatplayer("<p,neutral>I would like to enter Port Phasmatys - here's 2 Ectotokens.");
        if (inv_total(inv, ectotoken) < ^ahoy_toll) {
            mes("You do not have enough Ectotokens to pay the toll.");
            return;
        }
        inv_del(inv, ectotoken, ^ahoy_toll);
        ~ahoy_pass_barrier($inside);
    case 2 :
        ~chatplayer("<p,angry>I'm not paying you Ectotokens just to go through a gate.");
        ~chatnpc_specific("Ghost guard", ahoy_ghost_guard, "<p,neutral>Sorry - it's Town Policy.");
    case 3 :
        ~chatplayer("<p,quiz>Where can I get Ectotokens?");
        ~chatnpc_specific("Ghost guard", ahoy_ghost_guard, "<p,neutral>You need to go to the Temple and earn some. Talk to the disciples - they will tell you how.");
}

[opnpc1,ahoy_ghost_guard]
def_coord $barrier = 0_57_54_11_52;
if (distance(npc_coord, 0_57_54_4_29) < distance(npc_coord, 0_57_54_11_52)) {
    $barrier = 0_57_54_4_29;
}
if (~ahoy_in_phasmatys(coord) = true) {
    if (~ahoy_ghostspeak = false) {
        ~ahoy_ghost_wail;
        return;
    }
    ~chatnpc("<p,neutral>All visitors to Port Phasmatys must pay a toll charge of 2 Ectotokens.");
    return;
}
if ($barrier = 0_57_54_4_29) {
    @ahoy_guard_toll(movecoord($barrier, 1, 0, 0));
}
@ahoy_guard_toll(movecoord($barrier, 0, 0, -1));

[oploc1,ahoy_harbour_door]
if (loc_coord = 1_57_54_8_58) {
    @ahoy_temple_door;
}
~open_door(500);

[label,ahoy_temple_door]
if (coordx(coord) >= coordx(loc_coord) | %ahoy_templedoor_unlocked = ^true) {
    ~open_and_close_door(ahoy_harbour_door_open, ~check_axis(coord, loc_coord, loc_angle), false);
    return;
}
if (~ahoy_ghostspeak = false) {
    ~chatnpc_specific("Ghost disciple", ahoy_disciple, "<p,neutral>Woooo wooo wooooo woooo");
    return;
}
~chatnpc_specific("Ghost disciple", ahoy_disciple, "<p,angry>What are you doing going in there?");
~chatplayer("<p,shifty>Err, I was just curious...");
~chatnpc_specific("Ghost disciple", ahoy_disciple, "<p,neutral>Inside that room is a coffin, inside which lie the mortal remains of our most glorious master, Necrovarus. None may enter.");

[oplocu,ahoy_harbour_door]
if (last_useitem ! ahoy_bone_key | loc_coord ! 1_57_54_8_58) {
    ~displaymessage(^dm_default);
    return;
}
if (%ahoy_templedoor_unlocked = ^true) {
    mes("The door is already unlocked.");
    return;
}
%ahoy_templedoor_unlocked = ^true;
sound_synth(locked, 1, 0);
mes("You unlock the door.");

[oploc1,ahoy_trapdoor]
anim(human_openchest, 0);
mes("The trapdoor opens...");
sound_synth(door_open, 1, 0);
loc_change(ahoy_trapdoor_open, 500);

[oploc1,ahoy_trapdoor_open]
mes("You climb down through the trapdoor...");
~climb_ladder(3_57_154_21_32, false);

[oploc2,ahoy_trapdoor_open]
anim(human_closechest, 0);
mes("You close the trapdoor.");
