[oploc1,dwarf_keldagrim_bankbooth]
if (npc_findcat(loc_coord, bank_teller, 2, 0) = true) {
    @talk_to_banker;
}
@openbank;

[oploc2,dwarf_keldagrim_bankbooth] @openbank;

[opnpc1,dwarf_city_shop_warhammer]
~chatnpc("<p,angry>What do you want, human?");
~chatplayer("<p,quiz>Ehm, anything on offer?");
~chatnpc("<p,angry>Can you wield a warhammer? If not, then go away.");
def_int $option = ~p_choice2("Of course I can.", 1, "I can, but I won't.", 2);
if ($option = 1) {
    ~chatplayer("<p,happy>Of course I can.");
    ~openshop_activenpc;
    return;
}
~chatplayer("<p,neutral>I can, but I won't.");
~chatnpc("<p,angry>Yeah, right.");

[opnpc1,dwarf_city_shop_weapons]
~chatnpc("<p,happy>Welcome, human, to the Quality Weapons Shop! Can I interest you in a purchase?");
def_int $option = ~p_choice2("Yes, I'm looking for some weapons.", 1, "No thanks.", 2);
if ($option = 1) {
    ~chatplayer("<p,neutral>Yes, I'm looking for some weapons.");
    ~openshop_activenpc;
    return;
}
~chatplayer("<p,neutral>No thanks.");

[opnpc1,dwarf_city_shop_armour]
~chatnpc("<p,happy>Welcome to my store, human! Are you interested in buying anything?");
def_int $option = ~p_choice2("Yes, I'm looking for some armour.", 1, "No thanks.", 2);
if ($option = 1) {
    ~chatplayer("<p,neutral>Yes, I'm looking for some armour.");
    ~openshop_activenpc;
    return;
}
~chatplayer("<p,neutral>No thanks.");

[opnpc1,dwarf_city_shop_general_store]
~chatnpc("<p,happy>What can I interest you in? We have something of everything here!");
def_int $option = ~p_choice2("Oh good!", 1, "Nothing, thanks.", 2);
if ($option = 1) {
    ~chatplayer("<p,happy>Oh good!");
    ~openshop_activenpc;
    return;
}
~chatplayer("<p,neutral>Nothing, thanks.");

[opnpc1,dwarf_city_shop_bakery]
if (getqueue(stolen_from_stall_keldabread) > 0) {
    @stall_owner_alert_guards;
}
~chatnpc("<p,happy>Welcome to my stall! Come and buy some tasty bread, freshly baked just 2 months ago!");
def_int $option = ~p_choice2("Sounds delicious!", 1, "I think I'll pass.", 2);
if ($option = 1) {
    ~chatplayer("<p,happy>Sounds delicious!");
    ~openshop_activenpc;
    return;
}
~chatplayer("<p,neutral>I think I'll pass.");

