~displaymessage(^dm_default);

[ai_timer,dwarf_city_old_dwarf1]
npc_settimer(calc(15 + random(20)));
switch_int (random(6)) {
    case 0 : npc_say("No need to shout!");
    case 1 : npc_say("Calm down dear.");
    case 2 : npc_say("I don't see why.");
    case 3 : npc_say("Yes you did!");
    case 4 : npc_say("I did not!");
    case 5 : npc_say("What did you do that for?");
}

[ai_timer,dwarf_city_old_dwarf2]
npc_settimer(calc(15 + random(20)));
switch_int (random(6)) {
    case 0 : npc_say("That's the last straw!");
    case 1 : npc_say("Do your chores!");
    case 2 : npc_say("Useless... completely useless.");
    case 3 : npc_say("Don't talk to me like that!");
    case 4 : npc_say("You're no good!");
    case 5 : npc_say("I'm warning you, Hegir!");
}

[ai_timer,dwarf_city_trader_referee]
npc_settimer(calc(15 + random(20)));
switch_int (random(9)) {
    case 0 : npc_say("Stay inside your triangle!");
    case 1 : npc_say("Who's next?");
    case 2 : npc_say("Next bid please!");
    case 3 : npc_say("Need an offer, now!");
    case 4 : npc_say("Keep the goods flowing!");
    case 5 : npc_say("Keep it civil!");
    case 6 : npc_say("Come on, come on!");
    case 7 : npc_say("Go again please.");
    case 8 : npc_say("Hold on there!");
}
