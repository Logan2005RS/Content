[opnpc1,blandebir]
~chatplayer("<p,quiz>Hello, I wonder if you could help me on this whole brewing thing...");
~chatnpc("<p,neutral>I might be able to - what do you need to know?");
@keldagrim_blandebir_menu;

[label,keldagrim_blandebir_menu]
def_int $option = ~p_choice5("How do I brew ales?", 1, "How do I brew cider?", 2, "What do I do once my ale has matured?", 3, "Do you have any spare ale yeast?", 4, "That's all I need to know, thanks.", 5);
switch_int ($option) {
    case 1 :
        ~chatplayer("<p,quiz>How do I brew ales?");
        ~chatnpc("<p,neutral>Well first off you need to fill the vat with water - two bucketfuls should do the trick. Then you'll need to put in two handfuls of barley malt - that's roasted barley by the way.");
        ~chatnpc("<p,neutral>After that you'll be putting your main ingredient in - this will decide which ale it is you're brewing. There should be some good guides around with recipes in.");
        ~chatnpc("<p,neutral>Lastly you pour a pot full of ale yeast in, which'll start it off fermenting. Then all you have to do is wait for the good stuff.");
        @keldagrim_blandebir_menu;
    case 2 :
        ~chatplayer("<p,quiz>How do I brew cider?");
        ~chatnpc("<p,neutral>First you'll need some apples. You'll need to crush them using this cider-press - four apples should make a full bucket of apple-mush. Take four buckets of mush and fill up the vat.");
        ~chatnpc("<p,neutral>After that you pour a pot full of ale yeast in, which'll start it off fermenting. Then all you have to do is wait for the good stuff.");
        @keldagrim_blandebir_menu;
    case 3 :
        ~chatplayer("<p,quiz>What do I do once my ale has matured?");
        ~chatnpc("<p,neutral>Well, once you've got a full vat of the good stuff, just turn the valve and your barrel will fill up with eight pints of whatever your chosen tipple is. Mind it's an empty barrel, though.");
        @keldagrim_blandebir_menu;
    case 4 :
        ~chatplayer("<p,quiz>Do you have any spare ale yeast?");
        ~chatnpc("<p,neutral>Well, as a matter of fact I do, although I wouldn't describe it as spare. This ale yeast I've got is the best money can buy, but if you've got a pot I'll fill it for you for 25GP - very cheap as it happens.");
        if (inv_total(inv, pot_empty) < 1 & inv_total(inv, coins) < 25) {
            ~chatplayer("<p,sad>I don't have an empty pot, or enough money I'm afraid.");
            @keldagrim_blandebir_menu;
        }
        if (inv_total(inv, pot_empty) < 1) {
            ~chatplayer("<p,sad>I don't have an empty pot I'm afraid.");
            @keldagrim_blandebir_menu;
        }
        if (inv_total(inv, coins) < 25) {
            ~chatplayer("<p,sad>I don't have enough money I'm afraid.");
            @keldagrim_blandebir_menu;
        }
        def_int $buy = ~p_choice2("That's a good deal - please fill my pot with ale yeast for 25GP.", 1, "No, that's too much I'm afraid.", 2);
        if ($buy = 1) {
            ~chatplayer("<p,happy>That's a good deal - please fill my pot with ale yeast for 25GP.");
            inv_del(inv, coins, 25);
            inv_del(inv, pot_empty, 1);
            inv_add(inv, ale_yeast, 1);
        } else {
            ~chatplayer("<p,neutral>No, that's too much I'm afraid.");
        }
        @keldagrim_blandebir_menu;
    case 5 :
        ~chatplayer("<p,neutral>That's all I need to know, thanks.");
}

[oploc2,dwarf_keldagrim_furnace]
