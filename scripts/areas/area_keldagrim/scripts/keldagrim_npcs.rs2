[label,keldagrim_black_guard]
switch_int (random(5)) {
    case 0 : ~chatnpc("<p,angry>Obey the law!");
    case 1 : ~chatnpc("<p,angry>Stay out of trouble!");
    case 2 : ~chatnpc("<p,angry>Out of the way, human!");
    case 3 : ~chatnpc("<p,angry>I'm keeping an eye on you!");
    case 4 : ~mesbox("The guard ignores you.");
}

[opnpc1,dwarf_city_dwarf_man1]
~chatnpc("<p,angry>Can you leave me alone please? I'm trying to get a bit of rest.");

[opnpc1,dwarf_city_dwarf_man2]
~chatnpc("<p,angry>Do you mind? You're in my home.");
~chatplayer("<p,neutral>I'm sorry, should I have knocked?");
~chatnpc("<p,angry>Very funny, human.");
~chatnpc("<p,angry>We can't all live in plush houses, you know. But that doesn't mean us mining dwarves don't work hard.");
~chatplayer("<p,quiz>Where do you do your mining?");
~chatnpc("<p,bored>Normally the coal mine to the north. We need a lot of coal to keep our steam engines going, you know.");
~chatplayer("<p,quiz>Can I do a bit of mining there as well?");
~chatnpc("<p,bored>I'm not sure, but as long as no one notices I don't think anyone is going to care.");

[opnpc1,dwarf_city_dwarf_man4]
~chatnpc("<p,neutral>Welcome to my home. Is there anything you wanted?");
~chatplayer("<p,quiz>Nothing in particular. Got any sightseeing tips?");
~chatnpc("<p,neutral>No, I'm just a factory worker. Don't do tours.");
~chatplayer("<p,confused>This doesn't look like a factory.");
~chatnpc("<p,neutral>This is my home. I'm off-duty.");

[opnpc1,dwarf_city_dwarf_man6]
~chatnpc("<p,happy>I say, I say, a toast to this fine human!");
~chatplayer("<p,confused>What? I mean, err... why?");
~chatnpc("<p,happy>Why not!");
if (inv_total(inv, beer) > 0 | inv_total(inv, dwarven_stout) > 0) {
    ~chatplayer("<p,happy>Why not indeed! Cheers!");
    ~chatnpc("<p,happy>Cheers!");
    if (inv_total(inv, beer) > 0) {
        inv_del(inv, beer, 1);
    } else {
        inv_del(inv, dwarven_stout, 1);
    }
    inv_add(inv, beer_glass, 1);
    return;
}
if (inv_total(inv, jug_wine) > 0) {
    ~chatplayer("<p,neutral>Well, I have this jug of wine...");
    ~chatnpc("<p,neutral>No no, get a pint of beer, jugs of wine aren't good to toast with! Wine stains are terribly hard to wash out of a beard.");
    return;
}
~chatplayer("<p,neutral>I don't have anything suitable to toast with.");
~chatnpc("<p,happy>Then go get something from the bar!");

[opnpc1,dwarf_city_dwarf_man8]
~chatnpc("<p,happy>Kebabs! Get your kebabs here! One gold each!");
def_int $option = ~p_choice3("Sure, one kebab please.", 1, "I'm looking for a drunken dwarf.", 2, "Do you have any quests?", 3);
switch_int ($option) {
    case 1 :
        ~chatplayer("<p,happy>Sure, one kebab please.");
        if (inv_total(inv, coins) < 1) {
            ~chatnpc("<p,angry>Yes? Are you going to give me that one gold coin then?");
            ~chatplayer("<p,sad>Sorry, I don't seem to have any money on me.");
            ~chatnpc("<p,neutral>The bank is Keldagrim-West. Hurry back!");
            return;
        }
        inv_del(inv, coins, 1);
        inv_add(inv, kebab, 1);
    case 2 :
        ~chatplayer("<p,quiz>I'm looking for a drunken dwarf.");
        ~chatnpc("<p,neutral>Just go out in the streets, they can't be hard to find!");
        ~chatplayer("<p,neutral>No, a specific drunken dwarf, he keeps harassing me.");
        ~chatnpc("<p,neutral>That's still not very helpful. But let me see. There is one particularly drunken dwarf just to the northeast of here.");
        ~chatnpc("<p,neutral>He's scaring away my customers, he says there's something wrong with my kebabs. Quite annoying fellow.");
        ~chatplayer("<p,neutral>I don't think that's who I mean.");
        ~chatnpc("<p,neutral>Well, he does have a relative who wanders all over Gielinor. Comes back from time to time to buy more kebabs. Don't see him very often though.");
        ~chatplayer("<p,quiz>Do you think I'll have any chance of catching him here?");
        ~chatnpc("<p,neutral>I think he was back here quite recently, so I doubt he'll be back any time soon.");
    case 3 :
        ~chatplayer("<p,quiz>Do you have any quests?");
        ~chatnpc("<p,happy>Not really! I have a steady supply of meat coming in through the carts and I don't really need anything else!");
}

[opnpc1,dwarf_city_dwarf_man9]
~chatplayer("<p,quiz>Say, aren't you a bit tall for a dwarf?");
~chatnpc("<p,neutral>Was there anything in particular you wanted?");
def_int $option = ~p_choice2("I'd like a quest please.", 1, "No, I just like talking to strangers.", 2);
if ($option = 1) {
    ~chatplayer("<p,happy>I'd like a quest please.");
    ~chatnpc("<p,neutral>I have nothing to do for you, I'm afraid. Ask around town, though, there are always people who need some work done around here.");
    return;
}
~chatplayer("<p,happy>No, I just like talking to strangers.");
~chatnpc("<p,angry>Well I don't.");

[opnpc1,dwarf_city_dwarf_man10]
~chatnpc("<p,confused>What to buy? What to buy?");
~chatnpc("<p,neutral>Oh, hello human.");
~chatplayer("<p,quiz>Anything I can help you with?");
~chatnpc("<p,neutral>Only if you can help me make a suggestion on what to buy.");
~chatplayer("<p,happy>I smell a quest!");
~chatnpc("<p,neutral>No, not really. I just need some advice on what to buy, that's all.");
def_int $option = ~p_choice5("New clothes.", 1, "A warhammer.", 2, "A piece of rope.", 3, "An oversized hat.", 4, "Nothing.", 5);
switch_int ($option) {
    case 1 :
        ~chatplayer("<p,neutral>You should buy some new clothes. You can't go around town wearing what you're wearing.");
        ~chatnpc("<p,neutral>You're right, this is a little drab. I shouldn't really go around Keldagrim-West wearing this, should I?");
        ~chatnpc("<p,confused>Of course I still don't know what colour I should get. I don't want to accidentally offend the wrong company of course.");
        ~chatplayer("<p,neutral>Never mind.");
    case 2 :
        ~chatplayer("<p,happy>You should get yourself a big mighty warhammer.");
        ~chatnpc("<p,neutral>I don't think so. The warhammer shop is run by the Red Axe. I'd rather stay out of there.");
        ~chatplayer("<p,quiz>You don't like the Red Axe?");
        ~chatnpc("<p,angry>They're all a lot of bullies if you ask me.");
    case 3 :
        ~chatplayer("<p,neutral>Get yourself a long piece of rope.");
        ~chatnpc("<p,confused>What would I do with a rope?");
        ~chatplayer("<p,neutral>I don't know. I generally find a rope useful while adventuring.");
        ~chatnpc("<p,neutral>I don't do a lot of adventuring to be honest.");
    case 4 :
        ~chatplayer("<p,happy>An oversized hat. In a ridiculous colour.");
        ~chatnpc("<p,angry>No one is selling hats here, that's not a very helpful suggestion at all.");
    case 5 :
        ~chatplayer("<p,neutral>Nothing. You should buy absolutely nothing.");
        ~chatnpc("<p,happy>Now that's the best idea I've heard all day.");
        ~chatplayer("<p,happy>I thought so! Now why don't you give me some of the money I saved you?");
        ~chatnpc("<p,neutral>No, I don't think so. I think I'd rather buy something with my money after all.");
}

