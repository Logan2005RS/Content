    case 2 : ~chatnpc("<p,angry>Stay out of the octagon center!");
    case 3 : ~chatnpc("<p,angry>I can't help you!");
    case 4 : ~chatnpc("<p,angry>Can't talk to you, too busy!");
}

[opnpc1,dwarfrock_engineer1]
~chatnpc("<p,sad>I wish you'd just leave me alone.");
~chatplayer("<p,quiz>Why, what's wrong?");
~chatnpc("<p,sad>I was a great engineer once. Still am actually.");
~chatnpc("<p,sad>They just don't let me do the work I do best anymore.");
~chatplayer("<p,quiz>What do you do then?");
~chatnpc("<p,sad>I'm an assistant in this shop. I get all the lousy jobs too.");
