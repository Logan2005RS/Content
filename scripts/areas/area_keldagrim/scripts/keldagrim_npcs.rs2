[opnpc1,dwarf_city_barmaid_poor]
~chatnpc("<p,happy>Welcome to the Laughing Miner pub, human traveller.");
def_int $option = ~p_choice3("Who is that man walking around outside?", 1, "I'd like a beer please.", 2, "I'd like some food please.", 3);
switch_int ($option) {
    case 1 :
        ~chatplayer("<p,quiz>Who is that man walking around outside?");
        ~chatnpc("<p,confused>What man?");
        ~chatplayer("<p,neutral>I mean the dwarf, the one with the sign.");
        ~chatnpc("<p,neutral>Oh, him. Yes, we employ him to advertise our pub, he's the cheapest labour we could find. We don't have a lot of money to spare you know, we pay him in beer.");
        ~chatplayer("<p,quiz>But what's wrong with him?");
        ~chatnpc("<p,neutral>Well, he's drunk isn't he?");
        ~chatnpc("<p,neutral>I told you, he's cheap. He couldn't get any other work since the Red Axe fired him. Been drinking ever since.");
        ~chatplayer("<p,quiz>How did that happen?");
        ~chatnpc("<p,neutral>I'm not quite sure, I think he kept wearing the wrong coloured cap all the time. They don't much like it if you don't wear your red uniform into work.");
        ~chatplayer("<p,shock>They fired him for that??");
        ~chatnpc("<p,neutral>The Red Axe will fire you for just about anything if they want to.");
    case 2 :
        ~chatplayer("<p,happy>I'd like a beer please.");
        ~chatnpc("<p,neutral>That'll be 2 gold coins.");
        @keldagrim_barmaid_buy(beer, 2);
    case 3 :
        ~chatplayer("<p,happy>I'd like some food please.");
        ~chatnpc("<p,neutral>I can make you a stew for 20 gold coins.");
        @keldagrim_barmaid_buy(stew, 20);
}

[label,keldagrim_barmaid_buy](namedobj $obj, int $cost)
def_int $option = ~p_choice2("Pay.", 1, "Don't pay.", 2);
if ($option = 2) {
    ~chatplayer("<p,neutral>Sorry, I changed my mind.");
    return;
}
if (inv_total(inv, coins) < $cost) {
    ~chatplayer("<p,sad>Sorry, I don't have <tostring($cost)> coins on me.");
    return;
}
inv_del(inv, coins, $cost);
inv_add(inv, $obj, 1);
~chatnpc("<p,happy>Thanks for your custom.");

[opnpc1,dwarf_city_librarian]
~chatnpc("<p,happy>Welcome to the Keldagrim library, human traveller!");
~chatplayer("<p,quiz>Can you tell me more about the library?");
~chatnpc("<p,happy>Why, certainly, it is one of my favourite subjects!");
~chatnpc("<p,neutral>I am Hugi, you see, I am the chief librarian here. Hugi, my parents named me that, it means 'personification of thought' in the ancient dwarvish tongue.");
~chatnpc("<p,happy>Quite like the name myself.");
~chatnpc("<p,neutral>The books in this library have been collected for many centuries now, through various generous donations.");
~chatnpc("<p,neutral>You'll find books dating from many different eras as well, such as the Era of Kings, the Rise of the Consortium and the Era of Prosperity, our current era.");
~chatplayer("<p,quiz>How do these eras correspond with the Ages of the world?");
~chatnpc("<p,neutral>Oh, they are quite different, and most of them take place in the Fourth Age.");
~chatnpc("<p,neutral>Since we dwarves hid underground for a long time to sit out the wars that raged above the ground our history books differ slightly from those written by humans.");
~chatplayer("<p,happy>Thanks for the information!");

[opnpc1,dwarf_city_gardener_dwarf]
~chatnpc("<p,quiz>Come to visit my garden then, have you, human?");
def_int $option = ~p_choice2("This is your garden?", 1, "Not really, no.", 2);
if ($option = 2) {
    ~chatplayer("<p,neutral>Not really, no.");
    ~chatnpc("<p,neutral>Oh, alright then.");
    return;
}
~chatplayer("<p,quiz>This is your garden?");
~chatnpc("<p,neutral>No no, not quite. But I do look after it. It's the palace garden, you see. I keep it tidy, keep it living.");
~chatnpc("<p,neutral>It's hard to grow much on these hard rocks deep beneath these mountains, you know.");
~chatplayer("<p,quiz>I can imagine. Where do you get all your food from? Or even the soil for this garden?");
~chatnpc("<p,neutral>We can grow a little food underground, but most of it comes from the extensive steamcart network that runs beneath the earth.");
~chatnpc("<p,neutral>In the Era of Kings, many centuries ago, it was harder of course. Our steam technology was not developed as far yet and getting fresh supplies of food was always a problem.");
~chatnpc("<p,quiz>Oh, I'm not boring you, am I?");
$option = ~p_choice2("Not at all!", 1, "A little, yes.", 2);
if ($option = 2) {
    ~chatplayer("<p,neutral>A little, yes. I don't really know what all this has to do with anything.");
    ~chatnpc("<p,sad>I suppose it doesn't, really, it's just the mumblings of an old dwarf.");
    return;
}
~chatplayer("<p,happy>Not at all! Please, go on!");
~chatnpc("<p,neutral>Oh yes, as I was saying, it was difficult to make a decent living here. I'm afraid this garden was rather neglected during that time.");
~chatplayer("<p,quiz>Why did you dwarves stay so deep under ground, then? Why not simply go above ground?");
~chatnpc("<p,shock>What, with the wars raging up there?");
~chatnpc("<p,neutral>We dwarves went underground a long time ago, see. For a while the city of Keldagrim was completely cut off from the rest of Gielinor simply waiting out the wars of the humans and the gods.");
~chatnpc("<p,neutral>This made it hard, though, to determine when the wars above the ground were over. Perhaps Keldagrim had remained hidden for far too long.");
~chatnpc("<p,neutral>Only when King Alvis heroically defended the city against an invasion of trolls did we dare to venture out and see how much the world had changed.");
~chatnpc("<p,sad>Of course, after that...");
~chatnpc("<p,neutral>Ah well, enough history lessons I should say. I must really get back to my gardening.");
~chatplayer("<p,happy>Thanks for the info!");

[opnpc1,dwarf_city_trader_referee]
switch_int (random(5)) {
    case 0 : ~chatnpc("<p,angry>Talk to the secretaries, not to me!");
