[oploc1,dwarf_cavewall_tunnel]
p_arrivedelay;
p_telejump(^keldagrim_tunnel_east_coord);

[oploc1,dwarf_cave_entrance]
p_arrivedelay;
p_telejump(^keldagrim_tunnel_west_coord);

[opnpc1,dwarfrock_ferryman1]
~chatnpc("<p,neutral>Want to cross the river? It's just 2 gold pieces!");
if (inv_total(worn, ring_of_charos_unlocked) > 0) {
    @multi3("Yes please.", keldagrim_ferry_south_pay, "No thanks.", keldagrim_ferry_decline, "[Charm] I don't have any money on me.", keldagrim_ferry_south_charm);
}
@multi2("Yes please.", keldagrim_ferry_south_pay, "No thanks.", keldagrim_ferry_decline);

[label,keldagrim_ferry_south_pay]
~chatplayer("<p,neutral>Yes please.");
if (inv_total(inv, coins) < ^keldagrim_ferry_fare) {
    ~chatnpc("<p,neutral>You don't even have 2 gold coins, humans!");
    ~chatnpc("<p,neutral>Come back later.");
    return;
}
inv_del(inv, coins, ^keldagrim_ferry_fare);
@keldagrim_ferry_cross(^keldagrim_ferry_north_coord);

[label,keldagrim_ferry_south_charm]
~chatplayer("<p,neutral>I don't have any money on me, is that alright?");
~chatnpc("<p,confused>I... guess.");
@keldagrim_ferry_cross(^keldagrim_ferry_north_coord);

[opnpc1,dwarfrock_ferryman2]
~chatnpc("<p,neutral>Want to cross the river? It's just 2 gold pieces!");
if (inv_total(worn, ring_of_charos_unlocked) > 0) {
    @multi3("Yes please.", keldagrim_ferry_north_pay, "No thanks.", keldagrim_ferry_decline, "[Charm] I don't have any money on me.", keldagrim_ferry_north_charm);
}
@multi2("Yes please.", keldagrim_ferry_north_pay, "No thanks.", keldagrim_ferry_decline);

[label,keldagrim_ferry_north_pay]
~chatplayer("<p,neutral>Yes please.");
if (inv_total(inv, coins) < ^keldagrim_ferry_fare) {
    ~chatnpc("<p,neutral>You don't even have 2 gold coins, human!");
    ~chatnpc("<p,neutral>Come back later.");
    ~chatplayer("<p,sad>But... that means I'm stuck here.");
    ~chatnpc("<p,neutral>Hmm. I suppose I could make an exception for you this time.");
    if (inv_total(inv, coins) = 1) {
        ~chatnpc("<p,neutral>Here, let me just relieve you of that one coin you have there and I'll take you across.");
        inv_del(inv, coins, 1);
    }
    ~chatplayer("<p,happy>Thanks a lot!");
    @keldagrim_ferry_cross(^keldagrim_ferry_south_coord);
}
inv_del(inv, coins, ^keldagrim_ferry_fare);
@keldagrim_ferry_cross(^keldagrim_ferry_south_coord);

[label,keldagrim_ferry_north_charm]
~chatplayer("<p,sad>I don't have any money on me, now I'm stuck here forever!");
~chatnpc("<p,neutral>Oh, we wouldn't want that to happen. Come along, you can go for free this time.");
@keldagrim_ferry_cross(^keldagrim_ferry_south_coord);

[label,keldagrim_ferry_decline]
~chatplayer("<p,neutral>No thanks.");

[label,keldagrim_ferry_cross](coord $dest)
mes("The dwarf ferries you across the river.");
p_telejump($dest);

[opnpc1,dwarf_city_boatman_mines_prequest]
~chatnpc("<p,happy>Ho there, human!");
~chatplayer("<p,neutral><displayname()>.");
~chatnpc("<p,happy>Ho there, <displayname()>! Want to take a ride with me?");
~chatplayer("<p,quiz>Where are you going? Across the river?");
~chatnpc("<p,happy>No no, that's what the ferryman is for! I'm going to Keldagrim, my home!");
~chatplayer("<p,quiz>How much will that cost me then?");
~chatnpc("<p,happy>For a human like you, I can do it for free!");
@multi2("That's a deal!", keldagrim_boatman_deal, "I prefer the mines to the city.", keldagrim_boatman_mines);

[label,keldagrim_boatman_deal]
~chatplayer("<p,happy>That's a deal!");
~chatnpc("<p,happy>Excellent! I'm just waiting for my ship to arrive and then we can go.");
~chatnpc("<p,neutral>Mind, this trip could take a few minutes! Are you sure you're ready to go as well?");
def_int $option = ~p_choice2("Yes, I'm ready and don't mind it taking a few minutes.", 1, "No, I don't have time right now, I'll be back later.", 2);
if ($option = 2) {
    ~chatplayer("<p,neutral>No, I don't have time right now, I'll be back later.");
    ~chatnpc("<p,happy>Sure, sure! Come back when you need to!");
    return;
}
~chatplayer("<p,happy>Yes, I'm ready and don't mind it taking a few minutes.");
~chatnpc("<p,happy>Well, let's not waste any more time then!");
@keldagrim_boat_travel(^keldagrim_boat_city_coord);

[label,keldagrim_boatman_mines]
~chatplayer("<p,neutral>I prefer the mines to the city.");
~chatnpc("<p,neutral>Well, suit yourself then!");

[opnpc1,dwarf_city_boatman_city]
~chatnpc("<p,neutral>Want me to take you back to the mines?");
def_int $option = ~p_choice2("Yes, please take me.", 1, "What, on your ship! No thanks!", 2);
if ($option = 1) {
    ~chatplayer("<p,neutral>Yes, please take me.");
    @keldagrim_boat_travel(^keldagrim_boat_mines_coord);
}
~chatplayer("<p,angry>What, on your ship? No thanks! I don't want to crash into any more things!");
~chatnpc("<p,neutral>Hey now, it was only a slight accident!");
~chatnpc("<p,neutral>Calm down, calm down! You got what you paid for the trip, didn't you?");

[label,keldagrim_boat_travel](coord $dest)
~fade_out;
p_delay(4);
p_teleport($dest);
~fade_in;
p_delay(4);
if_openoverlay(null);
